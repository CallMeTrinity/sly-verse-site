{% extends '_layout' %}

{% block content %}
	{% import '_includes/macros' as macros %}
	{% set mediaType = entry.mediaType.value ?? 'photo' %}
	{% set gallery = entry.imageGallery.all() %}
	{% set relatedShow = entry.relatedShow.one() ?? null %}

	{# Header #}
	<section class="bg-linear-to-br from-black via-neutral-900 to-neutral-800 py-16 text-white lg:py-24">
		<div class="grid-container">
			{# Badges #}
			<div class="mb-4 flex flex-wrap gap-2">
				{% set typeLabels = { 'photo': 'Photo', 'video': 'Vidéo', 'galerie': 'Galerie' } %}
				{% set typeColors = { 'photo': 'bg-blue-600', 'video': 'bg-red-600', 'galerie': 'bg-purple-600' } %}
				<span class="rounded-sm px-3 py-1 text-xs font-bold uppercase {{ typeColors[mediaType] ?? 'bg-neutral-700' }}">
					{{ typeLabels[mediaType] ?? mediaType }}
				</span>
				{% if relatedShow %}
					<a href="{{ relatedShow.url }}" class="rounded-sm bg-neutral-700 px-3 py-1 text-xs font-bold uppercase transition-colors hover:bg-neutral-600">
						{{ relatedShow.title }}
					</a>
				{% endif %}
			</div>

			<h1 class="h1 mb-4 tracking-tight uppercase">{{ entry.title }}</h1>

			{% if entry.shortDescription %}
				<p class="text-lg text-neutral-300">{{ entry.shortDescription }}</p>
			{% endif %}

			<a href="{{ siteUrl('mediatheque') }}" class="mt-6 inline-flex items-center gap-2 text-sm text-neutral-400 transition-colors hover:text-white">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
				</svg>
				Retour à la médiathèque
			</a>
		</div>
	</section>

	{# Video embed #}
	{% if mediaType == 'video' and entry.videoUrl %}
		{% set videoUrl = entry.videoUrl %}
		{% if 'youtube.com/watch?v=' in videoUrl %}
			{% set videoId = videoUrl | split('v=') | last | split('&') | first %}
			{% set embedUrl = 'https://www.youtube.com/embed/' ~ videoId %}
		{% elseif 'youtu.be/' in videoUrl %}
			{% set videoId = videoUrl | split('youtu.be/') | last | split('?') | first %}
			{% set embedUrl = 'https://www.youtube.com/embed/' ~ videoId %}
		{% else %}
			{% set embedUrl = null %}
		{% endif %}

		<section class="bg-neutral-950 py-12 text-white lg:py-20">
			<div class="grid-container">
				{% if embedUrl %}
					<div class="aspect-video overflow-hidden rounded-lg bg-neutral-900">
						<iframe
							src="{{ embedUrl }}"
							class="h-full w-full"
							frameborder="0"
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
							allowfullscreen
						></iframe>
					</div>
				{% else %}
					<a
						href="{{ videoUrl }}"
						target="_blank"
						rel="noopener noreferrer"
						class="btn border-red-600 bg-red-600 text-white hover:border-red-700 hover:bg-red-700"
					>
						Voir la vidéo
					</a>
				{% endif %}
			</div>
		</section>
	{% endif %}

	{# Image Gallery with lightbox #}
	{% if gallery | length %}
		<section
			class="bg-black py-12 text-white lg:py-20"
			x-data="{
				lightbox: false,
				images: [
					{% for img in gallery %}
						{ src: '{{ img.url({ width: 1600 }) }}', alt: '{{ img.alt | e('js') }}' }{{ not loop.last ? ',' : '' }}
					{% endfor %}
				],
				index: 0,

				open(i) { this.index = i; this.lightbox = true },
				close() { this.lightbox = false },
				prev() { this.index = (this.index - 1 + this.images.length) % this.images.length },
				next() { this.index = (this.index + 1) % this.images.length },
				get current() { return this.images[this.index] || {} }
			}"
			@keydown.escape.window="close()"
			@keydown.left.window="lightbox && prev()"
			@keydown.right.window="lightbox && next()"
		>
			<div class="grid-container">
				{% if gallery | length > 1 %}
					<h2 class="h3 mb-8 uppercase">Galerie</h2>
				{% endif %}
				<div class="grid-row">
					{% for image in gallery %}
						<div class="grid-col mb-4 w-full sm:w-1/2 md:w-1/3 lg:mb-6">
							<div
								class="group cursor-pointer overflow-hidden rounded-lg bg-neutral-800"
								@click="open({{ loop.index0 }})"
							>
								<div class="relative aspect-video overflow-hidden">
									{{ macros.image(image, { width: 600, height: 400 }, 'h-full w-full object-cover transition-transform duration-500 group-hover:scale-110') }}
									<div class="absolute inset-0 flex items-center justify-center bg-black/0 transition-colors group-hover:bg-black/30">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white opacity-0 transition-opacity group-hover:opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
										</svg>
									</div>
								</div>
							</div>
						</div>
					{% endfor %}
				</div>
			</div>

			{# Lightbox #}
			<template x-teleport="body">
				<div
					x-show="lightbox"
					x-transition:enter="transition ease-out duration-200"
					x-transition:enter-start="opacity-0"
					x-transition:enter-end="opacity-100"
					x-transition:leave="transition ease-in duration-150"
					x-transition:leave-start="opacity-100"
					x-transition:leave-end="opacity-0"
					class="fixed inset-0 z-50 flex items-center justify-center bg-black/95 p-4"
					@click.self="close()"
				>
					<button @click="close()" class="absolute top-4 right-4 text-white/70 transition-colors hover:text-white">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
						</svg>
					</button>

					<button x-show="images.length > 1" @click="prev()" class="absolute left-4 text-white/70 transition-colors hover:text-white">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
						</svg>
					</button>

					<img :src="current.src" :alt="current.alt" class="max-h-[85vh] max-w-[90vw] rounded-lg object-contain shadow-2xl" />

					<button x-show="images.length > 1" @click="next()" class="absolute right-4 text-white/70 transition-colors hover:text-white">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
						</svg>
					</button>

					<div x-show="images.length > 1" class="absolute bottom-4 left-1/2 -translate-x-1/2 rounded-full bg-black/70 px-3 py-1 text-sm text-white/70">
						<span x-text="(index + 1) + ' / ' + images.length"></span>
					</div>
				</div>
			</template>
		</section>
	{% endif %}

	{# Related Show #}
	{% if relatedShow %}
		{% set showImage = relatedShow.mainImage.one() %}
		<section class="bg-neutral-950 py-12 text-white lg:py-20">
			<div class="grid-container">
				<h2 class="h3 mb-6 uppercase">Show associé</h2>
				<a href="{{ relatedShow.url }}" class="group flex overflow-hidden rounded-lg bg-neutral-900 shadow-lg transition-all duration-300 hover:bg-neutral-800">
					{% if showImage %}
						<div class="hidden w-48 shrink-0 overflow-hidden bg-neutral-800 sm:block">
							{{ macros.image(showImage, { width: 300, height: 170 }, 'h-full w-full object-cover transition-transform duration-500 group-hover:scale-105') }}
						</div>
					{% endif %}
					<div class="flex flex-1 items-center p-4 md:p-6">
						<div>
							{% if relatedShow.showType.value ?? null %}
								<span class="mb-2 inline-block rounded-sm bg-neutral-700 px-2 py-0.5 text-xs font-bold uppercase">
									{{ relatedShow.showType.label }}
								</span>
							{% endif %}
							<h3 class="h5 text-white transition-colors group-hover:text-red-500">{{ relatedShow.title }}</h3>
							{% if relatedShow.eventDateTime %}
								<p class="mt-1 text-sm text-neutral-500">{{ relatedShow.eventDateTime | date('d F Y', 'Europe/Paris') }}</p>
							{% endif %}
						</div>
					</div>
					<div class="flex shrink-0 items-center px-4 text-neutral-600 transition-colors group-hover:text-red-500">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
						</svg>
					</div>
				</a>
			</div>
		</section>
	{% endif %}
{% endblock %}
