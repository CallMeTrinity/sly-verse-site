{% import '_includes/macros' as macros %}
{% set image = entry.mainImage.one() %}
{% set timestamp = entry.eventDateTime ? entry.eventDateTime.timestamp * 1000 : 0 %}

{# Hero avec countdown #}
<section class="relative overflow-hidden py-16 lg:py-24" x-data="countdown({{ timestamp }})">
	{% if image %}
		<div class="absolute inset-0" data-hero-bg>
			{{ macros.image(image, { width: 1920 }, 'h-full w-full object-cover opacity-25') }}
		</div>
	{% endif %}
	<div class="from-bg via-bg/85 absolute inset-0 bg-linear-to-t to-black/40"></div>

	<div class="grid-container relative">
		<div class="mb-5 flex flex-wrap gap-2">
			{% if entry.showType.value ?? null %}
				{{ macros.showTypeBadge(entry.showType) }}
			{% endif %}
			<span class="bg-face rounded-sm px-2.5 py-1 text-[11px] font-extrabold tracking-wide text-white uppercase">
				À venir
			</span>
		</div>

		<h1 class="h1 mb-4">{{ entry.title }}</h1>

		{% if entry.eventDateTime %}
			<p class="text-gold mb-8 text-lg font-bold tracking-wide uppercase">
				{{ entry.eventDateTime | date('l d F Y \\à H\\hi', 'Europe/Paris') | capitalize }}
			</p>
		{% endif %}

		{# Countdown #}
		{% if timestamp %}
			<div x-show="!isPast" class="mb-9">
				<p class="text-ink-faint mb-4 text-sm font-bold tracking-widest uppercase">Commence dans</p>
				<div class="flex flex-wrap gap-3 sm:gap-4">
					{% for unit in [['days', 'Jours'], ['hours', 'Heures'], ['minutes', 'Minutes'], ['seconds', 'Secondes']] %}
						<div class="border-line bg-surface-2/80 min-w-[80px] rounded-lg border px-4 py-3 text-center backdrop-blur-sm">
							<span class="font-display block text-3xl font-bold tabular-nums" x-text="pad({{ unit[0] }})">00</span>
							<span class="text-ink-faint mt-1 block text-xs uppercase">{{ unit[1] }}</span>
						</div>
					{% endfor %}
				</div>
			</div>
		{% endif %}

		{# CTA stream #}
		{% if entry.externalLink %}
			<a href="{{ entry.externalLink }}" target="_blank" rel="noopener noreferrer" class="btn-primary">
				Regarder sur Twitch
			</a>
		{% endif %}
	</div>
</section>

{# Description #}
{% if entry.richContent | length %}
	<section class="bg-surface py-12 lg:py-16">
		<div class="grid-container" x-data x-reveal>
			<div class="prose text-ink-muted max-w-none">
				{{ entry.richContent }}
			</div>
		</div>
	</section>
{% endif %}

{# Carte annoncée (sans résultats) #}
{% set matches = entry.matchCard.all() %}
{% if matches | length %}
	<section class="py-12 lg:py-20">
		<div class="grid-container">
			<div class="mb-8" x-data x-reveal>
				<span class="eyebrow">Le programme</span>
				<h2 class="h2 mb-2">Carte annoncée</h2>
				<p class="text-ink-faint text-sm">Les résultats seront disponibles après le show.</p>
			</div>
			<div class="space-y-6">
				{% for match in matches %}
					<div x-data x-reveal.delay style="--i: {{ loop.index }}">
						{% include '_includes/_match-card' with { match: match, showResults: false } only %}
					</div>
				{% endfor %}
			</div>
		</div>
	</section>
{% endif %}
