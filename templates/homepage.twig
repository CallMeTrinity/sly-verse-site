{% extends '_layout' %}

{% block content %}
	{% import '_includes/macros' as macros %}
	{% set entry = craft.entries.section('pageAccueil').one() %}

	{# Hero Section #}
	{% set heroImage = entry.mainImage.one() %}
	<section class="relative overflow-hidden bg-black py-20 text-white lg:py-32">
		{% if heroImage %}
			<div class="absolute inset-0">
				{{ macros.image(heroImage, { width: 1920, height: 1080 }, 'h-full w-full object-cover') }}
				<div class="absolute inset-0 bg-black/70"></div>
			</div>
		{% else %}
			<div class="absolute inset-0 bg-linear-to-br from-black via-neutral-900 to-neutral-800"></div>
		{% endif %}
		<div class="grid-container relative" x-data x-reveal>
			<h1 class="h1 mb-6 text-center tracking-tight uppercase">{{ entry.heroTitle }}</h1>
			{% if entry.heroDescription %}
				<p class="mx-auto max-w-3xl text-center text-xl leading-relaxed text-neutral-300 lg:text-2xl">
					{{ entry.heroDescription }}
				</p>
			{% endif %}
		</div>
	</section>

	{# Superstars Section #}
	{% set superstars = craft.entries.section('superstars').limit(4).orderBy('RAND()').all() %}
	{% if superstars | length %}
		<section class="bg-neutral-950 py-12 text-white lg:py-20">
			<div class="grid-container">
				<div class="mb-8 flex items-end justify-between" x-data x-reveal>
					<h2 class="h3 uppercase">Superstars</h2>
					<a href="/superstars" class="text-sm font-medium text-neutral-400 transition-colors hover:text-white">
						Voir toutes &rarr;
					</a>
				</div>
				<div class="grid-row">
					{% for superstar in superstars %}
						<div class="grid-col mb-4 w-full sm:w-1/2 md:w-1/3 lg:w-1/4 lg:mb-6" x-data x-reveal.delay style="--i: {{ loop.index }}">
							{% include '_includes/_superstar-card' with { superstar: superstar } only %}
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}

	{# Upcoming Shows Section #}
	{% set upcomingShows = craft.entries.section('shows').showStatus('aVenir').orderBy('eventDateTime asc').limit(3).all() %}
	{% if upcomingShows | length %}
		<section class="bg-black py-12 text-white lg:py-20">
			<div class="grid-container">
				<div class="mb-8 flex items-end justify-between" x-data x-reveal>
					<h2 class="h3 uppercase">Prochains shows</h2>
					<a href="/shows" class="text-sm font-medium text-neutral-400 transition-colors hover:text-white">
						Voir tous &rarr;
					</a>
				</div>
				<div class="grid-row">
					{% for show in upcomingShows %}
						{% set image = show.mainImage.one() %}
						<div class="grid-col mb-4 w-full md:w-1/2 lg:w-1/3 lg:mb-6" x-data x-reveal.delay style="--i: {{ loop.index }}">
							<a href="{{ show.url }}" class="group block overflow-hidden rounded-lg bg-neutral-900 shadow-lg transition-all duration-300 hover:scale-[1.02] hover:shadow-2xl">
								<div class="relative aspect-video overflow-hidden bg-neutral-800">
									{% if image %}
										{{ macros.image(image, { width: 600, height: 340 }, 'h-full w-full object-cover transition-transform duration-500 group-hover:scale-110') }}
									{% endif %}
									{% if show.showType.value ?? null %}
										<span class="absolute top-3 left-3 rounded-sm bg-red-600 px-2 py-1 text-xs font-bold uppercase">
											{{ show.showType.label }}
										</span>
									{% endif %}
								</div>
								<div class="p-4">
									<h3 class="h5 mb-2 text-white transition-colors group-hover:text-red-500">{{ show.title }}</h3>
									{% if show.eventDateTime %}
										<p class="text-sm text-neutral-400">{{ show.eventDateTime | date('d/m/Y \\à H\\hi') }}</p>
									{% endif %}
								</div>
							</a>
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}

	{# Social Media Section #}
	{% set socials = entry.socialMedia.all() %}
	{% if socials | length %}
		<section class="bg-neutral-950 py-12 lg:py-20">
			<div class="grid-container">
				<h2 class="h3 mb-8 text-center text-white uppercase" x-data x-reveal>Nos liens</h2>
				<div class="flex flex-wrap justify-center gap-4 lg:gap-6">
					{% for social in socials %}
						{% set image = social.linkImage.one() %}
						{% if image %}
							<a
								href="{{ social.basicLink.value }}"
								class="group relative h-40 w-40 flex-shrink-0 overflow-hidden rounded-full bg-neutral-900 shadow-lg ring-2 ring-white/10 transition-all duration-300 hover:scale-110 hover:ring-white/40 hover:shadow-2xl lg:h-48 lg:w-48"
								target="_blank"
								rel="noopener noreferrer"
								x-data x-reveal.delay
								style="--i: {{ loop.index }}"
							>
								<img
									src="{{ image.url }}"
									alt="{{ image.title }}"
									class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
									loading="lazy"
								/>
								<div class="absolute inset-0 bg-black/40 transition-opacity group-hover:bg-black/20"></div>
								<div class="absolute inset-0 flex items-end justify-center pb-5">
									<span class="rounded-full bg-black/70 px-3 py-1 text-xs font-semibold tracking-wider text-white uppercase backdrop-blur-sm lg:text-sm">
										{{ image.title }}
									</span>
								</div>
							</a>
						{% endif %}
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}
{% endblock %}
