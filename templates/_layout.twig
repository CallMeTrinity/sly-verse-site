<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		{# SEO : title, meta description, canonical, robots, Open Graph, Twitter Card, JSON-LD #}
		{# Overrides par page : {% set seoTitle / seoDescription / seoImage / seoType / seoRobots %} en haut du template #}
		{% include '_includes/seo' %}

		{# Include local fonts #}
		{% include '_includes/fonts' %}

		{# Preconnect hints for external resources #}
		<link rel="preconnect" href="https://www.youtube.com" />
		<link rel="dns-prefetch" href="https://www.youtube.com" />

		{# Adds JS and CSS processed with Vite #}
		{# ? https://nystudio107.com/docs/vite/#the-script-function #}
		{# The false argument here disables async CSS to prevent FOUT #}
		{{ craft.vite.script('src/js/app.js', false) }}

		{# Favicon #}
		<link rel="icon" href="/favicon.png" type="image/png" />
		<link rel="apple-touch-icon" href="/SWU.png" />
		<meta name="theme-color" content="#171c26" />
	</head>

	<body>
		{# Adds the Admin Bar plugin to the page #}
		{# {{ adminBar() }} #}

		<a
			class="bg-blue absolute -m-1 h-0 w-0 overflow-hidden border-0 p-0 text-center text-white focus:relative focus:m-0 focus:block focus:h-auto focus:w-full focus:p-2"
			href="#main"
		>
			<span>Skip to main content</span>
		</a>

		{% include '_includes/alertBar' %}
		{% include '_includes/header' %}

		{# Panneau mobile hors du <header> : son backdrop-filter en ferait le bloc conteneur du position:fixed #}
		{% include '_includes/_nav' with {
			variant: 'mobile'
		} %}

		<main id="main">
			{% block content %}

			{% endblock %}
		</main>
		{% include '_includes/footer' %}
	</body>
</html>
