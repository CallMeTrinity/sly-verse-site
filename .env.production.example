# =============================================================================
# .env de production — Craft CMS sur Infomaniak
# =============================================================================
# 1. Copier ce fichier sur le serveur en tant que .env
# 2. Remplir les valeurs marquees REMPLACER_*
# 3. Copier CRAFT_APP_ID et CRAFT_SECURITY_KEY depuis votre .env local
# =============================================================================

# The application ID used to uniquely store session and cache data, mutex locks, and more
CRAFT_APP_ID=REMPLACER_PAR_VOTRE_APP_ID

# The environment Craft is currently running in
CRAFT_ENVIRONMENT=production

# Database connection settings (Infomaniak)
CRAFT_DB_DRIVER=mysql
CRAFT_DB_SERVER=REMPLACER_PAR_HOTE_DB.myd.infomaniak.com
CRAFT_DB_PORT=3306
CRAFT_DB_DATABASE=REMPLACER_PAR_NOM_DB
CRAFT_DB_USER=REMPLACER_PAR_USER_DB
CRAFT_DB_PASSWORD=REMPLACER_PAR_MDP_DB
CRAFT_DB_SCHEMA=
CRAFT_DB_TABLE_PREFIX=

# General settings
CRAFT_SECURITY_KEY=REMPLACER_PAR_VOTRE_SECURITY_KEY
SYSTEM_STATUS=on
SYSTEM_NAME=sly-verse-site
CRAFT_DEV_MODE=false
CRAFT_ALLOW_ADMIN_CHANGES=true
CRAFT_DISALLOW_ROBOTS=false
CRAFT_WEB_ROOT=/home/clients/VOTRE_ID/web/web
PRIMARY_SITE_URL=https://REMPLACER_PAR_VOTRE_DOMAINE.com

# Plugin License Keys
PLUGIN_FORMIE=
PLUGIN_HYPER=
PLUGIN_RETOUR=
PLUGIN_SEOMATIC=

# Settings > Email
EMAIL_SYSTEM_ADDRESS=
EMAIL_SENDER=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_AUTH=
EMAIL_USERNAME=
EMAIL_PASSWORD=
