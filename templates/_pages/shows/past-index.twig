{% extends '_layout' %}

{% do seomatic.meta.seoTitle('Résultats') %}
{% do seomatic.meta.seoDescription('Tous les résultats des shows passés de la Sly Wrestling Universe.') %}

{% block content %}
	{% import '_includes/macros' as macros %}
	{% set shows = craft.entries.section('shows').showStatus('termine').orderBy('eventDateTime desc').all() %}

	{# Page Header #}
	<section class="bg-surface py-16 lg:py-24">
		<div class="grid-container">
			<span class="eyebrow">Les archives</span>
			<h1 class="h1 mb-3">Résultats</h1>
			<p class="text-ink-muted">
				Historique des shows passés
			</p>
		</div>
	</section>

	{# Shows groupés par année #}
	<section class="py-12 lg:py-20">
		<div class="grid-container">
			{% if shows|length %}
				{% set byYear = shows|group(s => s.eventDateTime ? s.eventDateTime|date('Y') : 'Non daté') %}
				{% for year, yearShows in byYear %}
					<h2 class="font-display text-ink-faint mb-6 text-2xl font-bold uppercase {{ not loop.first ? 'mt-14' }}">
						{{ year }}
					</h2>
					<div class="border-line divide-line divide-y overflow-hidden rounded-lg border" x-data x-reveal>
						{% for show in yearShows %}
							{% include '_includes/_result-row' with {
								show: show
							} only %}
						{% endfor %}
					</div>
				{% endfor %}
			{% else %}
				<p class="text-ink-faint py-12 text-center">
					Aucun résultat disponible pour le moment.
				</p>
			{% endif %}
		</div>
	</section>
{% endblock %}
