<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		{# Title, meta description, canonical, Open Graph #}
		{# Défauts ci-dessous, overrides via {% set pageTitle/pageDescription/pageImage/pageRobots %} en tête de template #}
		{% set pageTitle = pageTitle ?? (entry is defined and entry ? entry.title : null) %}
		{% set pageDescription =
			pageDescription ?? 'Fédération de catch fictive Sly Wrestling Universe : shows, résultats, superstars, articles et médias.'
		%}
		{% set pageImage = pageImage ?? (siteUrl ~ 'SWU.png') %}
		{% set pageRobots = pageRobots ?? null %}
		{% set metaTitle = pageTitle ? pageTitle ~ ' | ' ~ siteName : siteName %}
		{% set canonicalUrl = craft.app.request.absoluteUrl %}

		<title>{{ metaTitle }}</title>
		<meta name="description" content="{{ pageDescription }}" />
		<link rel="canonical" href="{{ canonicalUrl }}" />
		{% if pageRobots %}
			<meta name="robots" content="{{ pageRobots }}" />
		{% endif %}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="{{ siteName }}" />
		<meta property="og:title" content="{{ metaTitle }}" />
		<meta property="og:description" content="{{ pageDescription }}" />
		<meta property="og:url" content="{{ canonicalUrl }}" />
		<meta property="og:image" content="{{ pageImage }}" />
		<meta name="twitter:card" content="summary_large_image" />

		{# Include local fonts #}
		{% include '_includes/fonts' %}

		{# Preconnect hints for external resources #}
		<link rel="preconnect" href="https://www.youtube.com" />
		<link rel="dns-prefetch" href="https://www.youtube.com" />

		{# Adds JS and CSS processed with Vite #}
		{# ? https://nystudio107.com/docs/vite/#the-script-function #}
		{# The false argument here disables async CSS to prevent FOUT #}
		{{ craft.vite.script('src/js/app.js', false) }}

		{# Favicon #}
		<link rel="icon" href="/favicon.png" type="image/png" />
		<link rel="apple-touch-icon" href="/SWU.png" />
		<meta name="theme-color" content="#171c26" />
	</head>

	<body>
		{# Adds the Admin Bar plugin to the page #}
		{# {{ adminBar() }} #}

		<a
			class="bg-blue absolute -m-1 h-0 w-0 overflow-hidden border-0 p-0 text-center text-white focus:relative focus:m-0 focus:block focus:h-auto focus:w-full focus:p-2"
			href="#main"
		>
			<span>Skip to main content</span>
		</a>

		{% include '_includes/alertBar' %}
		{% include '_includes/header' %}

		{# Panneau mobile hors du <header> : son backdrop-filter en ferait le bloc conteneur du position:fixed #}
		{% include '_includes/_nav' with {
			variant: 'mobile'
		} %}

		<main id="main">
			{% block content %}

			{% endblock %}
		</main>
		{% include '_includes/footer' %}
	</body>
</html>
