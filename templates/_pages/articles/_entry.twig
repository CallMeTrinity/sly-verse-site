{% extends '_layout' %}

{% set seoImage = entry.mainImage.one() %}
{% if seoImage %}
	{% do seomatic.meta.seoImage(seoImage.getUrl({ width: 1200 })) %}
{% endif %}
{% if entry.shortDescription %}
	{% do seomatic.meta.seoDescription(entry.shortDescription|striptags|trim) %}
{% endif %}

{% block content %}
	{% import '_includes/macros' as macros %}
	{% set image = entry.mainImage.one() %}

	{# Hero Banner #}
	<section class="bg-bg relative overflow-hidden py-20 text-white lg:py-32">
		{% if image %}
			<div class="absolute inset-0">
				{{
					macros.image(
						image,
						{
							width: 1920,
							height: 800
						},
						'h-full w-full object-cover'
					)
				}}
				<div class="absolute inset-0 bg-black/60"></div>
			</div>
		{% else %}
			<div class="bg-surface absolute inset-0"></div>
		{% endif %}
		<div class="grid-container relative" x-data x-reveal>
			<p class="mb-4 text-sm font-semibold tracking-wider text-red-500 uppercase">
				{{ entry.postDate|date('d/m/Y') }}
			</p>
			<h1 class="h1 mb-6 tracking-tight uppercase">{{ entry.title }}</h1>
			{% if entry.shortDescription %}
				<p class="text-ink-muted max-w-3xl text-xl leading-relaxed lg:text-2xl">
					{{ entry.shortDescription }}
				</p>
			{% endif %}
		</div>
	</section>

	{# Article Body #}
	{% if entry.richContent|length %}
		<section class="bg-surface py-12 text-white lg:py-20">
			<div class="grid-container" x-data x-reveal>
				<div class="prose text-ink-muted mx-auto max-w-4xl">
					{{ entry.richContent }}
				</div>
			</div>
		</section>
	{% endif %}

	{# Related Superstars #}
	{% set relatedSuperstars = entry.relatedSuperstars.all() ?? [] %}
	{% if relatedSuperstars|length %}
		<section class="bg-bg py-12 text-white lg:py-20">
			<div class="grid-container">
				<h2 class="h3 mb-8 uppercase" x-data x-reveal>Superstars mentionn&eacute;es</h2>
				<div class="grid-row">
					{% for superstar in relatedSuperstars %}
						<div
							class="grid-col mb-4 w-full sm:w-1/2 md:w-1/3 lg:mb-6 lg:w-1/4"
							x-data
							x-reveal.delay
							style="--i: {{ loop.index }}"
						>
							{% include '_includes/_superstar-card' with {
								superstar: superstar
							} only %}
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}
{% endblock %}
