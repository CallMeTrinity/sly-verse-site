{% extends '_layout' %}

{% block content %}
	{% set entry = craft.entries.section('pageAccueil').one() %}

	{# Hero Section - WWE-inspired bold header #}
	<section class="bg-linear-to-br from-black via-neutral-900 to-neutral-800 px-4 py-20 text-white lg:py-32">
		<div class="container mx-auto max-w-7xl">
			<h1 class="h1 mb-6 text-center tracking-tight uppercase">{{ entry.heroTitle }}</h1>
			<div class="prose prose-lg mx-auto max-w-3xl text-center text-neutral-300">
				<p class="text-xl leading-relaxed lg:text-2xl">
					{{ entry.heroDescription }}
				</p>
			</div>
		</div>
	</section>

	{# Social Media Section - Card-based layout #}
	<section class="bg-neutral-950 px-4 py-16 lg:py-24">
		<div class="container mx-auto max-w-7xl">
			<h2 class="h2 mb-12 text-center text-white uppercase">Les liens</h2>

			<div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:gap-6">
				{% for social in entry.socialMedia.all() %}
					{% set image = social.linkImage.one() %}
					{% if image %}
						<a
							href="{{ social.basicLink.value }}"
							class="group relative aspect-square overflow-hidden rounded-lg bg-neutral-900 shadow-xl transition-all duration-300 hover:scale-105 hover:shadow-2xl hover:shadow-white/10"
							target="_blank"
							rel="noopener noreferrer"
						>
							<div
								class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent opacity-60 transition-opacity group-hover:opacity-40"
							></div>
							<img
								src="{{ image.url }}"
								alt="{{ image.title }}"
								class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-110"
								loading="lazy"
							/>
							<div class="absolute right-0 bottom-0 left-0 p-3 text-center">
								<span
									class="text-xs font-semibold tracking-wider text-white uppercase opacity-0 transition-opacity group-hover:opacity-100 lg:text-sm"
								>
									{{ image.title }}
								</span>
							</div>
						</a>
					{% else %}
						{# Show placeholder when no image #}
						<div
							class="flex aspect-square items-center justify-center rounded-lg bg-neutral-800 p-4 text-center text-xs text-neutral-500"
						>
							No image uploaded
						</div>
					{% endif %}
				{% endfor %}
			</div>
		</div>
	</section>

	{# Additional Content Section - Ready for expansion #}
	<section class="bg-black px-4 py-16 lg:py-24">
		<div class="container mx-auto max-w-7xl">
			<div
				class="rounded-2xl border-2 border-white/10 bg-linear-to-br from-neutral-900 to-black p-8 text-center lg:p-16"
			>
				<h3 class="h3 mb-4 text-white uppercase">Stay Updated</h3>
				<p class="mx-auto max-w-2xl text-lg text-neutral-400">
					Follow our social channels for the latest updates, exclusive content, and behind-the-scenes action.
				</p>
			</div>
		</div>
	</section>
{% endblock %}
