# =============================================================================
# .env de developpement local — Craft CMS sous DDEV
# =============================================================================
# 1. Copier ce fichier en .env  (cp .env.example .env)
# 2. Generer CRAFT_APP_ID et CRAFT_SECURITY_KEY (voir plus bas)
# 3. ddev start puis ddev import-db --file=<dump.sql>
#
# Le pendant production est .env.production.example
# =============================================================================

# -----------------------------------------------------------------------------
# ATTENTION — CRAFT_SECURITY_KEY
# Cette cle chiffre les donnees sensibles stockees en base (licences plugins,
# mots de passe de config). Elle DOIT etre identique a celle utilisee pour
# chiffrer le dump que vous restaurez, sinon Craft ne pourra pas les relire.
# Conservez la cle du projet dans un gestionnaire de mots de passe.
#
# Pour un projet neuf uniquement :
#   ddev craft setup/app-id
#   ddev craft setup/security-key
# -----------------------------------------------------------------------------
CRAFT_APP_ID=
CRAFT_SECURITY_KEY=

# The environment Craft is currently running in
CRAFT_ENVIRONMENT=dev

# Database connection settings (DDEV : hote "db", creds db/db/db)
CRAFT_DB_DRIVER=mysql
CRAFT_DB_SERVER=db
CRAFT_DB_PORT=3306
CRAFT_DB_DATABASE=db
CRAFT_DB_USER=db
CRAFT_DB_PASSWORD=db
CRAFT_DB_SCHEMA=
CRAFT_DB_TABLE_PREFIX=

# General settings
SYSTEM_STATUS=on
SYSTEM_NAME=sly-verse-site
CRAFT_DEV_MODE=true
CRAFT_ALLOW_ADMIN_CHANGES=true
CRAFT_DISALLOW_ROBOTS=true
CRAFT_WEB_ROOT=/var/www/html/web
PRIMARY_SITE_URL=https://sly-verse-site.ddev.site:8443

# Plugin License Keys (laisser vide en local, les plugins tournent en mode essai)
PLUGIN_FORMIE=
PLUGIN_HYPER=
PLUGIN_RETOUR=
PLUGIN_SEOMATIC=

# Settings > Email (inutile en local, DDEV capture les mails via Mailpit)
EMAIL_SYSTEM_ADDRESS=
EMAIL_SENDER=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_AUTH=
EMAIL_USERNAME=
EMAIL_PASSWORD=
