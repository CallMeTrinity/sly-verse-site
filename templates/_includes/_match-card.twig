{# Card de match — expects `match` (bloc Matrix matchCard) et `showResults` (bool, défaut false) #}
{% import '_includes/macros' as macros %}
{% import _self as self %}

{% macro fighterCard(fighter, isWinner, dimmed) %}
	{% import '_includes/macros' as macros %}
	{% set photo = fighter.profileImage.one() %}
	<a
		href="{{ fighter.url }}"
		class="group block w-28 text-center transition-opacity sm:w-32 lg:w-36 {{
		dimmed
			? 'opacity-60 grayscale-[0.4] hover:opacity-100 hover:grayscale-0'
			: ''
		}}"
	>
		<div
			class="bg-surface-3 relative mx-auto aspect-[3/4] overflow-hidden rounded-lg {{
			isWinner
				? 'ring-gold ring-2'
				: 'border-line border'
			}}"
		>
			{% if photo %}
				{{
					macros.image(
						photo,
						{
							width: 300,
							height: 400
						},
						'h-full w-full object-cover transition-transform duration-500 group-hover:scale-105'
					)
				}}
			{% else %}
				<div class="text-ink-faint flex h-full w-full items-center justify-center">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="h-10 w-10"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="1"
							d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
						/>
					</svg>
				</div>
			{% endif %}
			{% if isWinner %}
				<span
					class="bg-gold absolute top-2 right-2 flex size-6 items-center justify-center rounded-full text-sm text-black"
					title="Vainqueur"
				>
					★
				</span>
			{% endif %}
		</div>
		<span
			class="font-display group-hover:text-gold mt-2 block text-xs leading-tight font-bold uppercase transition-colors"
		>
			{{ fighter.title }}
		</span>
	</a>
{% endmacro %}

{% set showResults = showResults ?? false %}
{% set fighters = match.fighters.all() %}
{% set winners = showResults ? match.vainqueur.all() : [] %}
{% set winnerIds = winners|map(w => w.id) %}
{% set fightImage = match.fightImage.one() %}
{% set ratingValue = showResults ? match.matchRating.value : null %}
{% set rating = ratingValue ? ratingValue * 1 : null %}
{% set ratingLabel = ratingValue
	? ratingValue|replace({
		'.': ','
	})
	: null
%}

<div class="border-line bg-surface-2 overflow-hidden rounded-lg border">
	{# Image du match en bandeau #}
	{% if fightImage %}
		<div class="bg-surface-3 relative aspect-[21/9] overflow-hidden">
			{{
				macros.image(
					fightImage,
					{
						width: 1280,
						height: 549
					},
					'h-full w-full object-cover'
				)
			}}
			<div class="to-surface-2/90 absolute inset-0 bg-linear-to-b from-transparent via-transparent"></div>
		</div>
	{% endif %}

	<div class="p-6 lg:p-8">
		{# Badges type & stipulation #}
		<div class="mb-3 flex flex-wrap items-center gap-2">
			{% if match.matchType %}
				<span
					class="bg-surface-3 text-ink-muted rounded-sm px-2.5 py-1 text-[11px] font-bold tracking-wide uppercase"
				>
					{{ match.matchType }}
				</span>
			{% endif %}
			{% if match.stipulation %}
				<span
					class="bg-heel/15 text-heel ring-heel/40 rounded-sm px-2.5 py-1 text-[11px] font-bold tracking-wide uppercase ring-1"
				>
					{{ match.stipulation }}
				</span>
			{% endif %}
			{# Note du match (demi-étoiles : on rogne l'étoile dorée à 50 %) #}
			{% if rating %}
				{% set starPath =
					'M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z'
				%}
				<div class="ml-auto flex items-center gap-1.5" role="img" aria-label="Note : {{ ratingLabel }} sur 5">
					<div class="flex items-center gap-0.5" aria-hidden="true">
						{% for i in 1..5 %}
							<span class="relative block size-4">
								<svg class="text-line-strong absolute inset-0 size-4" viewBox="0 0 20 20" fill="currentColor">
									<path d="{{ starPath }}" />
								</svg>
								{% if rating >= i - 0.5 %}
									<span
										class="absolute inset-y-0 left-0 overflow-hidden {{ rating >= i ? 'w-full' : 'w-1/2' }}"
									>
										<svg class="text-gold size-4 max-w-none" viewBox="0 0 20 20" fill="currentColor">
											<path d="{{ starPath }}" />
										</svg>
									</span>
								{% endif %}
							</span>
						{% endfor %}
					</div>
					<span class="text-gold text-xs font-bold">{{ ratingLabel }}</span>
				</div>
			{% endif %}
		</div>

		<h3 class="h5 mb-6">{{ match.matchTitle ?? match.title }}</h3>

		{# Face-à-face des combattants #}
		{% set hasWinners = (winners|length) > 0 %}
		{% if (fighters|length) == 2 %}
			<div class="flex items-center justify-center gap-6 py-2 sm:gap-12">
				{% set isWinnerA = fighters[0].id in winnerIds %}
				{% set isWinnerB = fighters[1].id in winnerIds %}
				{{ self.fighterCard(fighters[0], isWinnerA, hasWinners and not isWinnerA) }}
				<span class="font-display text-gold text-xl font-bold uppercase sm:text-3xl">VS</span>
				{{ self.fighterCard(fighters[1], isWinnerB, hasWinners and not isWinnerB) }}
			</div>
		{% elseif fighters|length %}
			<div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-6 py-2 sm:gap-x-6">
				{% for fighter in fighters %}
					{% set isWinner = fighter.id in winnerIds %}
					{{ self.fighterCard(fighter, isWinner, hasWinners and not isWinner) }}
					{% if not loop.last %}
						<span class="font-display text-gold text-sm font-bold uppercase">vs</span>
					{% endif %}
				{% endfor %}
			</div>
		{% endif %}

		{# Résultat #}
		{% if showResults and (match.results|length) %}
			<div class="border-line mt-6 border-t pt-5">
				<span class="text-ink-faint mb-2 block text-xs font-bold tracking-wider uppercase">Résultat</span>
				<div class="prose text-ink-muted max-w-none text-sm">
					{{ match.results }}
				</div>
			</div>
		{% endif %}

		{# Bannière vainqueur(s) #}
		{% if winners|length %}
			<div class="bg-gold/10 ring-gold/30 mt-5 flex flex-wrap items-center gap-2 rounded-md px-4 py-2.5 ring-1">
				<span class="text-gold">★</span>
				<span class="text-ink-faint text-xs font-bold tracking-wider uppercase">
					{{ (winners|length) > 1 ? 'Vainqueurs' : 'Vainqueur' }}
				</span>
				{% for winner in winners %}
					<a href="{{ winner.url }}" class="text-gold hover:text-gold-bright font-bold transition-colors">
						{{ winner.title }}
					</a>
					{% if not loop.last %}
						<span class="text-gold/50">&amp;</span>
					{% endif %}
				{% endfor %}
			</div>
		{% endif %}
	</div>
</div>
