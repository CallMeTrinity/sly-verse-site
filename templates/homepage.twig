{% extends '_layout' %}

{% set entry = craft.entries.section('pageAccueil').one() %}
{% do seomatic.meta.seoTitle('Accueil') %}
{% if entry.heroDescription ?? null %}
	{% do seomatic.meta.seoDescription(entry.heroDescription|striptags|trim) %}
{% endif %}
{% set homeOgImage = entry.mainImage.one() ?? null %}
{% if homeOgImage %}
	{% do seomatic.meta.seoImage(homeOgImage.getUrl({ width: 1200 })) %}
{% endif %}

{% block content %}
	{% import '_includes/macros' as macros %}

	{# Hero #}
	{% set heroImage = entry.mainImage.one() %}
	<section class="relative flex min-h-[88svh] items-center overflow-hidden" data-hero>
		{% if heroImage %}
			<div class="absolute inset-0" data-hero-bg>
				{{
					macros.image(
						heroImage,
						{
							width: 1920,
							height: 1080
						},
						'h-full w-full object-cover'
					)
				}}
			</div>
		{% else %}
			<div
				class="absolute inset-0 bg-[repeating-linear-gradient(115deg,oklch(0.22_0.02_250)_0px,oklch(0.22_0.02_250)_2px,oklch(0.19_0.02_250)_2px,oklch(0.19_0.02_250)_40px)]"
			></div>
		{% endif %}
		<div class="from-bg via-bg/70 absolute inset-0 bg-linear-to-t to-black/30"></div>

		<div class="grid-container relative w-full py-24">
			<div
				class="border-gold text-gold mb-6 inline-block rounded-sm border px-3.5 py-1.5 text-xs font-extrabold tracking-[0.15em] uppercase"
				data-hero-item
			>
				Fédération indépendante
			</div>
			<h1
				class="font-display mb-5 max-w-4xl text-[clamp(42px,7vw,96px)] leading-[0.98] font-bold tracking-tight uppercase"
				data-hero-item
			>
				{{ entry.heroTitle }}
			</h1>
			{% if entry.heroDescription %}
				<div class="text-ink-muted mb-9 max-w-xl text-lg leading-relaxed lg:text-xl" data-hero-item>
					{{ entry.heroDescription }}
				</div>
			{% endif %}
			<div class="flex flex-wrap gap-4" data-hero-item>
				<a href="/shows" class="btn-primary">Voir les shows</a>
				<a href="/comment-participer" class="btn-ghost">Rejoindre le roster</a>
			</div>
		</div>
	</section>

	{# SWU News #}
	{% set featuredArticles = entry.featuredArticles.all() ?? [] %}
	{% if not featuredArticles|length and entry.showLatestArticles ?? false %}
		{% set featuredArticles = craft.entries.section('articles').orderBy('postDate desc').limit(3).all() %}
	{% endif %}
	{% if featuredArticles|length %}
		<section class="bg-surface py-14 lg:py-20">
			<div class="grid-container">
				<div class="mb-10 flex flex-wrap items-end justify-between gap-4" x-data x-reveal>
					<div>
						<span class="eyebrow">Actualités</span>
						<h2 class="h2 mb-0">SWU News</h2>
					</div>
					<a
						href="/articles"
						class="border-gold hover:text-gold border-b-2 pb-0.5 text-sm font-bold uppercase transition-colors"
					>
						Tous les articles &rarr;
					</a>
				</div>
				<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
					{% for article in featuredArticles %}
						<div x-data x-reveal.delay style="--i: {{ loop.index }}">
							{% include '_includes/_article-card' with {
								article: article
							} only %}
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}

	{# Superstars #}
	{% set superstars = craft.entries.section('superstars').limit(4).orderBy('RAND()').all() %}
	{% if superstars|length %}
		<section class="py-14 lg:py-24">
			<div class="grid-container">
				<div class="mb-10 flex flex-wrap items-end justify-between gap-4" x-data x-reveal>
					<div>
						<span class="eyebrow">Le roster</span>
						<h2 class="h2 mb-0">Superstars</h2>
					</div>
					<a
						href="/superstars"
						class="border-gold hover:text-gold border-b-2 pb-0.5 text-sm font-bold uppercase transition-colors"
					>
						Voir tout le roster &rarr;
					</a>
				</div>
				<div class="grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-6">
					{% for superstar in superstars %}
						<div x-data x-reveal.delay style="--i: {{ loop.index }}">
							{% include '_includes/_superstar-card' with {
								superstar: superstar
							} only %}
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}

	{# Prochains shows #}
	{% set upcomingShows =
		craft.entries.section('shows').showStatus('aVenir').orderBy('eventDateTime asc').limit(3).all()
	%}
	{% if upcomingShows|length %}
		<section class="bg-surface py-14 lg:py-24">
			<div class="grid-container">
				<div class="mb-10" x-data x-reveal>
					<span class="eyebrow">À l'affiche</span>
					<h2 class="h2 mb-0">Prochains shows</h2>
				</div>
				<div class="grid gap-6 lg:grid-cols-3">
					{% for show in upcomingShows %}
						<div
							class="{{ loop.first and (upcomingShows|length) > 1 ? 'lg:col-span-2 lg:row-span-1' : '' }}"
							x-data
							x-reveal.delay
							style="--i: {{ loop.index }}"
						>
							{% include '_includes/_show-card' with {
								show: show,
								featured: loop.first
							} only %}
						</div>
					{% endfor %}
				</div>
				<div class="mt-8 text-center">
					<a href="/shows" class="btn-outline">Tous les shows</a>
				</div>
			</div>
		</section>
	{% endif %}

	{# Résultats récents #}
	{% set pastShows =
		craft.entries.section('shows').showStatus('termine').orderBy('eventDateTime desc').limit(4).all()
	%}
	{% if pastShows|length %}
		<section class="py-14 lg:py-24">
			<div class="grid-container">
				<div class="mb-10 flex flex-wrap items-end justify-between gap-4" x-data x-reveal>
					<div>
						<span class="eyebrow">Les archives</span>
						<h2 class="h2 mb-0">Résultats récents</h2>
					</div>
					<a
						href="/resultats"
						class="border-gold hover:text-gold border-b-2 pb-0.5 text-sm font-bold uppercase transition-colors"
					>
						Tous les résultats &rarr;
					</a>
				</div>
				<div class="border-line divide-line divide-y overflow-hidden rounded-lg border" x-data x-reveal>
					{% for show in pastShows %}
						{% include '_includes/_result-row' with {
							show: show
						} only %}
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}

	{# Clips #}
	{% set featuredClips = entry.featuredClips.all() ?? [] %}
	{% if not featuredClips|length and entry.showLatestClips ?? false %}
		{% set featuredClips = craft.entries.section('clips').orderBy('postDate desc').limit(4).all() %}
	{% endif %}
	{% if featuredClips|length %}
		<section class="bg-surface py-14 lg:py-24">
			<div class="grid-container">
				<div class="mb-10 flex flex-wrap items-end justify-between gap-4" x-data x-reveal>
					<div>
						<span class="eyebrow">Highlights</span>
						<h2 class="h2 mb-0">Clips</h2>
					</div>
					<a
						href="/clips"
						class="border-gold hover:text-gold border-b-2 pb-0.5 text-sm font-bold uppercase transition-colors"
					>
						Voir tous &rarr;
					</a>
				</div>
				<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
					{% for clip in featuredClips %}
						<div x-data x-reveal.delay style="--i: {{ loop.index }}">
							{% include '_includes/_clip-card' with {
								clip: clip
							} only %}
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}

	{# Teaser planning #}
	{% set schedule = craft.entries.section('streamSchedule').one() %}
	{% if schedule %}
		{% set nextStreams =
			schedule.upcomingStreams.all()|filter(s => s.eventDateTime and s.eventDateTime >= now)|slice(0, 3)
		%}
		{% if nextStreams|length %}
			<section class="py-14 lg:py-24">
				<div class="grid-container">
					<div class="mb-10 flex flex-wrap items-end justify-between gap-4" x-data x-reveal>
						<div>
							<span class="eyebrow">Ne rate rien</span>
							<h2 class="h2 mb-0">Prochains streams</h2>
						</div>
						<a
							href="/planning"
							class="border-gold hover:text-gold border-b-2 pb-0.5 text-sm font-bold uppercase transition-colors"
						>
							Voir le planning &rarr;
						</a>
					</div>
					<div class="grid gap-5 md:grid-cols-3" x-data x-reveal>
						{% for stream in nextStreams %}
							<div class="border-line bg-surface-2 border-l-blue rounded-md border border-l-3 p-5">
								<p class="text-gold mb-2 text-xs font-extrabold tracking-wide uppercase">
									{{ stream.eventDateTime|date('d/m — H\\hi') }}
								</p>
								<h3 class="font-display mb-2 text-base font-bold uppercase">{{ stream.title }}</h3>
								{% if stream.shortDescription %}
									<p class="text-ink-muted text-sm">
										{{ stream.shortDescription }}
									</p>
								{% endif %}
							</div>
						{% endfor %}
					</div>
				</div>
			</section>
		{% endif %}
	{% endif %}

	{# Bannière Participer #}
	{% include '_includes/_cta-participate' %}
{% endblock %}
