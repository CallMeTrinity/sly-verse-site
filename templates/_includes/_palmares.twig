{# Palmarès compact, groupé par ceinture #}
{# Expects a `palmares` variable : craft.cwe.palmares(entry) #}
{% import '_includes/macros' as macros %}

{% if palmares|length %}
	<section class="bg-bg py-12 text-white lg:py-20">
		<div class="grid-container">
			<div class="mb-8 flex flex-wrap items-end justify-between gap-4" x-data x-reveal>
				<h2 class="h3 mb-0 uppercase">Palmar&egrave;s</h2>
				<p class="text-ink-muted text-sm">
					{% set total = palmares|reduce((sum, p) => sum + p.count, 0) %}
					{{ total }} règne{{ total > 1 ? 's' }} · {{ palmares|length }} titre{{ palmares|length > 1 ? 's' }}
				</p>
			</div>

			<ul class="border-line divide-line divide-y overflow-hidden rounded-lg border" x-data x-reveal>
				{% for item in palmares %}
					{% set belt = item.belt %}
					{% set beltImage = belt.beltImage.one() %}
					<li class="bg-surface-2 flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:gap-6 lg:px-6">
						<a href="{{ belt.url }}" class="group flex min-w-0 flex-1 items-center gap-4">
							<div class="bg-surface-3 flex h-12 w-20 shrink-0 items-center justify-center rounded-md">
								{% if beltImage %}
									{{
										macros.image(
											beltImage,
											{
												width: 160,
												height: 96
											},
											'h-10 w-auto max-w-18 object-contain'
										)
									}}
								{% endif %}
							</div>
							<div class="min-w-0">
								<p class="group-hover:text-gold font-display truncate text-sm font-bold uppercase transition-colors">
									{{ belt.title }}
								</p>
								{% if item.current %}
									<span class="text-gold text-xs font-bold uppercase">Champion en titre</span>
								{% endif %}
							</div>
						</a>

						<div class="flex flex-wrap items-center gap-2 sm:justify-end">
							<span class="font-display mr-1 text-2xl leading-none font-bold">{{ item.count }}&times;</span>
							{% for reign in item.reigns %}
								<span
									class="{{ reign.current ? 'bg-gold text-black' : 'bg-surface-3 text-ink-muted' }} rounded-full px-2.5 py-1 text-xs font-semibold"
									title="Règne n°{{ reign.number }} de la ceinture{{ reign.via ? ' · avec ' ~ reign.via.title }}"
								>
									{{ reign.start ? reign.start|date('Y') : '#' ~ reign.number }}{{ reign.current ? ' · en cours' }}{{ reign.via ? ' · ' ~ reign.via.title }}
								</span>
							{% endfor %}
						</div>
					</li>
				{% endfor %}
			</ul>
		</div>
	</section>
{% endif %}
