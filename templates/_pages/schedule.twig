{% extends '_layout' %}

{% block content %}
	{# Page Header #}
	<section class="bg-linear-to-br from-black via-neutral-900 to-neutral-800 py-16 text-white lg:py-24">
		<div class="grid-container">
			<h1 class="h1 text-center tracking-tight uppercase">Planning Streams</h1>
		</div>
	</section>

	{# Upcoming Streams #}
	<section class="bg-black py-12 text-white lg:py-20">
		<div class="grid-container">
			{% set streams = entry.upcomingStreams.all() %}
			{% if streams | length %}
				<div class="space-y-4">
					{% for stream in streams %}
						<div class="rounded-lg border border-white/10 bg-neutral-900 p-6 transition-colors hover:border-white/20">
							<div class="grid-row items-center">
								<div class="grid-col w-full sm:w-auto sm:shrink-0">
									{% if stream.eventDateTime %}
										<div class="mb-3 inline-block rounded-lg bg-red-600 px-4 py-2 text-center sm:mb-0">
											<span class="block text-2xl font-bold leading-none">{{ stream.eventDateTime | date('d') }}</span>
											<span class="block text-xs uppercase">{{ stream.eventDateTime | date('M Y') }}</span>
											<span class="block text-sm font-medium">{{ stream.eventDateTime | date('H\\hi') }}</span>
										</div>
									{% endif %}
								</div>
								<div class="grid-col flex-1">
									<h3 class="h5 mb-1 text-white">{{ stream.title }}</h3>
									{% if stream.shortDescription ?? null %}
										<p class="text-sm text-neutral-400">{{ stream.shortDescription }}</p>
									{% endif %}
								</div>
								{% if stream.externalLink ?? null %}
									<div class="grid-col mt-3 w-full sm:mt-0 sm:w-auto">
										<a href="{{ stream.externalLink }}" target="_blank" rel="noopener noreferrer" class="btn border-red-600 bg-red-600 text-sm text-white hover:bg-red-700 hover:border-red-700">
											Twitch
										</a>
									</div>
								{% endif %}
							</div>
						</div>
					{% endfor %}
				</div>
			{% else %}
				<p class="text-center text-neutral-500">Aucun stream pr&eacute;vu pour le moment.</p>
			{% endif %}
		</div>
	</section>
{% endblock %}
