{# Ligne résultat de show — expects `show` (entry terminée) #}
{# À empiler dans un wrapper : <div class="border-line divide-line divide-y overflow-hidden rounded-lg border"> #}
{% import '_includes/macros' as macros %}
{% set image = show.mainImage.one() %}

<a
	href="{{ show.url }}"
	class="bg-surface-2 hover:bg-surface-3 group flex items-center gap-4 px-4 py-4 transition-colors sm:gap-6 sm:px-6"
>
	<div class="bg-surface-3 size-16 shrink-0 overflow-hidden rounded-md">
		{% if image %}
			{{
				macros.image(
					image,
					{
						width: 128,
						height: 128
					},
					'h-full w-full object-cover'
				)
			}}
		{% endif %}
	</div>
	<div class="min-w-0 flex-1">
		{% if show.eventDateTime %}
			<p class="text-ink-faint mb-1 text-xs font-bold tracking-wide uppercase">
				{{ show.eventDateTime|date('d/m/Y') }}
			</p>
		{% endif %}
		<h3 class="font-display group-hover:text-gold truncate text-base font-bold uppercase transition-colors">
			{{ show.title }}
		</h3>
	</div>
	{% if show.showType.value ?? null %}
		{{ macros.showTypeBadge(show.showType, 'hidden shrink-0 md:inline-block') }}
	{% endif %}
	<span class="text-gold border-gold hidden shrink-0 border-b-2 pb-0.5 text-[13px] font-bold uppercase sm:block">
		Détails &rarr;
	</span>
</a>
