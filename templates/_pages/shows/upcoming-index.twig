{% extends '_layout' %}

{% block content %}
	{% import '_includes/macros' as macros %}
	{% set shows = craft.entries.section('shows').showStatus('aVenir').orderBy('eventDateTime asc').all() %}

	{# Page Header #}
	<section class="bg-linear-to-br from-black via-neutral-900 to-neutral-800 py-16 text-white lg:py-24">
		<div class="grid-container">
			<h1 class="h1 text-center tracking-tight uppercase">Shows à venir</h1>
			<p class="mt-4 text-center text-neutral-400">Prochains événements du SWU</p>
		</div>
	</section>

	{% if shows | length %}
		{# Featured — prochain show #}
		{% set nextShow = shows | first %}
		{% set nextImage = nextShow.mainImage.one() %}
		{% set nextTimestamp = nextShow.eventDateTime ? nextShow.eventDateTime.timestamp * 1000 : 0 %}

		<section
			class="relative bg-neutral-950 py-12 text-white lg:py-20"
			x-data="{
				target: {{ nextTimestamp }},
				days: 0, hours: 0, minutes: 0, seconds: 0,
				init() {
					this.update()
					setInterval(() => this.update(), 1000)
				},
				update() {
					const diff = this.target - Date.now()
					if (diff <= 0) { this.days = this.hours = this.minutes = this.seconds = 0; return }
					this.days    = Math.floor(diff / 86400000)
					this.hours   = Math.floor((diff % 86400000) / 3600000)
					this.minutes = Math.floor((diff % 3600000) / 60000)
					this.seconds = Math.floor((diff % 60000) / 1000)
				},
				pad(n) { return String(n).padStart(2, '0') }
			}"
		>
			<div class="grid-container">
				<p class="mb-6 text-sm font-semibold tracking-widest text-red-500 uppercase">Prochain show</p>

				<a href="{{ nextShow.url }}" class="group block overflow-hidden rounded-xl bg-neutral-900 shadow-2xl transition-all duration-300 hover:ring-2 hover:ring-red-600">
					{# Image hero #}
					{% if nextImage %}
						<div class="relative aspect-[21/9] overflow-hidden bg-neutral-800">
							{{ macros.image(nextImage, { width: 1400, height: 600 }, 'h-full w-full object-cover transition-transform duration-700 group-hover:scale-105') }}
							<div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/30 to-transparent"></div>

							{# Badges on image #}
							<div class="absolute top-4 left-4 flex gap-2">
								{% if nextShow.showType.value ?? null %}
									<span class="rounded-sm bg-red-600 px-3 py-1 text-xs font-bold uppercase">
										{{ nextShow.showType.label }}
									</span>
								{% endif %}
								<span class="rounded-sm bg-green-700 px-3 py-1 text-xs font-bold uppercase">À venir</span>
							</div>
						</div>
					{% endif %}

					{# Content #}
					<div class="p-6 md:p-8">
						<h2 class="h2 mb-3 text-white transition-colors group-hover:text-red-500">{{ nextShow.title }}</h2>

						{% if nextShow.eventDateTime %}
							<p class="mb-6 text-neutral-300">
								{{ nextShow.eventDateTime | date('l d F Y \\à H\\hi', 'Europe/Paris') | capitalize }}
							</p>
						{% endif %}

						{# Countdown #}
						{% if nextTimestamp %}
							<div class="mb-6 flex flex-wrap gap-3">
								<div class="min-w-[70px] rounded-lg bg-white/5 px-3 py-3 text-center ring-1 ring-white/10">
									<span class="block text-2xl font-black tabular-nums" x-text="pad(days)">00</span>
									<span class="mt-1 block text-xs text-neutral-500 uppercase">Jours</span>
								</div>
								<div class="min-w-[70px] rounded-lg bg-white/5 px-3 py-3 text-center ring-1 ring-white/10">
									<span class="block text-2xl font-black tabular-nums" x-text="pad(hours)">00</span>
									<span class="mt-1 block text-xs text-neutral-500 uppercase">Heures</span>
								</div>
								<div class="min-w-[70px] rounded-lg bg-white/5 px-3 py-3 text-center ring-1 ring-white/10">
									<span class="block text-2xl font-black tabular-nums" x-text="pad(minutes)">00</span>
									<span class="mt-1 block text-xs text-neutral-500 uppercase">Minutes</span>
								</div>
								<div class="min-w-[70px] rounded-lg bg-white/5 px-3 py-3 text-center ring-1 ring-white/10">
									<span class="block text-2xl font-black tabular-nums" x-text="pad(seconds)">00</span>
									<span class="mt-1 block text-xs text-neutral-500 uppercase">Secondes</span>
								</div>
							</div>
						{% endif %}

						{# Twitch CTA #}
						{% if nextShow.externalLink %}
							<span class="btn border-red-600 bg-red-600 text-white hover:border-red-700 hover:bg-red-700">
								Regarder sur Twitch
							</span>
						{% endif %}
					</div>
				</a>
			</div>
		</section>

		{# Other upcoming shows #}
		{% if shows | length > 1 %}
			<section class="bg-black py-12 text-white lg:py-20">
				<div class="grid-container">
					<h2 class="h3 mb-8 uppercase">Prochainement</h2>
					<div class="grid-row">
						{% for show in shows | slice(1) %}
							{% set image = show.mainImage.one() %}
							<div class="grid-col mb-4 w-full md:w-1/2 lg:w-1/3 lg:mb-6">
								<a href="{{ show.url }}" class="group block overflow-hidden rounded-lg bg-neutral-900 shadow-lg transition-all duration-300 hover:scale-[1.02] hover:shadow-2xl">
									<div class="relative aspect-video overflow-hidden bg-neutral-800">
										{% if image %}
											{{ macros.image(image, { width: 600, height: 340 }, 'h-full w-full object-cover transition-transform duration-500 group-hover:scale-110') }}
										{% endif %}
										{% if show.showType.value ?? null %}
											<span class="absolute top-3 left-3 rounded-sm bg-red-600 px-2 py-1 text-xs font-bold uppercase">
												{{ show.showType.label }}
											</span>
										{% endif %}
									</div>
									<div class="p-4">
										<h3 class="h5 mb-2 text-white transition-colors group-hover:text-red-500">{{ show.title }}</h3>
										{% if show.eventDateTime %}
											<p class="text-sm text-neutral-400">
												{{ show.eventDateTime | date('d F Y \\à H\\hi', 'Europe/Paris') }}
											</p>
										{% endif %}
										{% if show.externalLink %}
											<span class="mt-3 inline-block text-xs font-semibold text-red-500 uppercase">
												Regarder sur Twitch →
											</span>
										{% endif %}
									</div>
								</a>
							</div>
						{% endfor %}
					</div>
				</div>
			</section>
		{% endif %}

	{% else %}
		<section class="bg-black py-12 text-white lg:py-20">
			<div class="grid-container">
				<p class="py-12 text-center text-neutral-500">Aucun show annoncé pour le moment.</p>
			</div>
		</section>
	{% endif %}
{% endblock %}
