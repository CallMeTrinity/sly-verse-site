{% extends '_layout' %}

{% block content %}
	{% import '_includes/macros' as macros %}
	{% set upcomingShows = craft.entries.section('shows').showStatus('aVenir').orderBy('eventDateTime asc').all() %}
	{% set pastShows =
		craft.entries.section('shows').showStatus('termine').orderBy('eventDateTime desc').limit(6).all()
	%}
	{% set nextShow = upcomingShows|first %}
	{% set otherShows = upcomingShows|slice(1) %}

	{# Featured : prochain show + countdown #}
	{% if nextShow %}
		{% set image = nextShow.mainImage.one() %}
		{% set timestamp = nextShow.eventDateTime ? nextShow.eventDateTime.timestamp * 1000 : 0 %}
		<section class="relative overflow-hidden py-16 lg:py-24" x-data="countdown({{ timestamp }})">
			{% if image %}
				<div class="absolute inset-0" data-hero-bg>
					{{
						macros.image(
							image,
							{
								width: 1920
							},
							'h-full w-full object-cover opacity-25'
						)
					}}
				</div>
			{% endif %}
			<div class="from-bg via-bg/85 absolute inset-0 bg-linear-to-t to-black/40"></div>

			<div class="grid-container relative">
				<span class="eyebrow">Prochain show</span>
				<div class="mb-5 flex flex-wrap gap-2">
					{% if nextShow.showType.value ?? null %}
						{{ macros.showTypeBadge(nextShow.showType) }}
					{% endif %}
				</div>
				<h1 class="h1 mb-4">{{ nextShow.title }}</h1>
				{% if nextShow.eventDateTime %}
					<p class="text-gold mb-8 text-lg font-bold tracking-wide uppercase">
						{{ nextShow.eventDateTime|date('l d F Y \\à H\\hi', 'Europe/Paris')|capitalize }}
					</p>
				{% endif %}

				{% if timestamp %}
					<div x-show="!isPast" class="mb-9">
						<div class="flex flex-wrap gap-3 sm:gap-4">
							{% for unit in [
								['days', 'Jours'],
								['hours', 'Heures'],
								['minutes', 'Minutes'],
								['seconds', 'Secondes']
							] %}
								<div
									class="border-line bg-surface-2/80 min-w-[80px] rounded-lg border px-4 py-3 text-center backdrop-blur-sm"
								>
									<span class="font-display block text-3xl font-bold tabular-nums" x-text="pad({{ unit[0] }})">
										00
									</span>
									<span class="text-ink-faint mt-1 block text-xs uppercase">{{ unit[1] }}</span>
								</div>
							{% endfor %}
						</div>
					</div>
				{% endif %}

				<div class="flex flex-wrap gap-4">
					<a href="{{ nextShow.url }}" class="btn-primary">Voir la carte</a>
					{% if nextShow.externalLink %}
						<a href="{{ nextShow.externalLink }}" target="_blank" rel="noopener noreferrer" class="btn-ghost">
							Regarder sur Twitch
						</a>
					{% endif %}
				</div>
			</div>
		</section>
	{% else %}
		<section class="bg-surface py-16 lg:py-24">
			<div class="grid-container">
				<span class="eyebrow">À l'affiche</span>
				<h1 class="h1 mb-4">Shows</h1>
				<p class="text-ink-muted">
					Aucun show programmé pour le moment — reste connecté.
				</p>
			</div>
		</section>
	{% endif %}

	{# Autres shows à venir #}
	{% if otherShows|length %}
		<section class="bg-surface py-14 lg:py-20">
			<div class="grid-container">
				<div class="mb-10" x-data x-reveal>
					<span class="eyebrow">Et ensuite</span>
					<h2 class="h2 mb-0">Aussi à l'affiche</h2>
				</div>
				<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
					{% for show in otherShows %}
						<div x-data x-reveal.delay style="--i: {{ loop.index }}">
							{% include '_includes/_show-card' with {
								show: show
							} only %}
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}

	{# Derniers résultats #}
	{% if pastShows|length %}
		<section class="py-14 lg:py-20">
			<div class="grid-container">
				<div class="mb-10 flex flex-wrap items-end justify-between gap-4" x-data x-reveal>
					<div>
						<span class="eyebrow">Les archives</span>
						<h2 class="h2 mb-0">Derniers résultats</h2>
					</div>
					<a
						href="/resultats"
						class="border-gold hover:text-gold border-b-2 pb-0.5 text-sm font-bold uppercase transition-colors"
					>
						Tous les résultats &rarr;
					</a>
				</div>
				<div class="border-line divide-line divide-y overflow-hidden rounded-lg border" x-data x-reveal>
					{% for show in pastShows %}
						{% include '_includes/_result-row' with {
							show: show
						} only %}
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}

	{% include '_includes/_cta-participate' %}
{% endblock %}
