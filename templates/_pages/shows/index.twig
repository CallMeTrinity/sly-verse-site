{% extends '_layout' %}

{% block content %}
	{% import '_includes/macros' as macros %}

	{% set upcomingShows = craft.entries.section('shows').showStatus('aVenir').orderBy('eventDateTime asc').all() %}
	{% set pastShows = craft.entries.section('shows').showStatus('termine').orderBy('eventDateTime desc').all() %}

	{# Page Header #}
	<section class="bg-linear-to-br from-black via-neutral-900 to-neutral-800 py-16 text-white lg:py-24">
		<div class="grid-container">
			<h1 class="h1 text-center tracking-tight uppercase">Shows</h1>
		</div>
	</section>

	{# Upcoming Shows #}
	{% if upcomingShows | length %}
		<section class="bg-neutral-950 py-12 text-white lg:py-20">
			<div class="grid-container">
				<h2 class="h3 mb-8 uppercase">&Agrave; venir</h2>
				<div class="grid-row">
					{% for show in upcomingShows %}
						{% set image = show.mainImage.one() %}
						<div class="grid-col mb-4 w-full md:w-1/2 lg:w-1/3 lg:mb-6">
							<a href="{{ show.url }}" class="group block overflow-hidden rounded-lg bg-neutral-900 shadow-lg transition-all duration-300 hover:scale-[1.02] hover:shadow-2xl">
								<div class="relative aspect-video overflow-hidden bg-neutral-800">
									{% if image %}
										{{ macros.image(image, { width: 600, height: 340 }, 'h-full w-full object-cover transition-transform duration-500 group-hover:scale-110') }}
									{% endif %}
									{% if show.showType.value ?? null %}
										<span class="absolute top-3 left-3 rounded-sm bg-red-600 px-2 py-1 text-xs font-bold uppercase">
											{{ show.showType.label }}
										</span>
									{% endif %}
								</div>
								<div class="p-4">
									<h3 class="h5 mb-2 text-white transition-colors group-hover:text-red-500">{{ show.title }}</h3>
									{% if show.eventDateTime %}
										<p class="text-sm text-neutral-400">{{ show.eventDateTime | date('d/m/Y \\à H\\hi') }}</p>
									{% endif %}
								</div>
							</a>
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}

	{# Past Shows #}
	{% if pastShows | length %}
		<section class="bg-black py-12 text-white lg:py-20">
			<div class="grid-container">
				<h2 class="h3 mb-8 uppercase">R&eacute;sultats</h2>
				<div class="grid-row">
					{% for show in pastShows %}
						{% set image = show.mainImage.one() %}
						<div class="grid-col mb-4 w-full md:w-1/2 lg:w-1/3 lg:mb-6">
							<a href="{{ show.url }}" class="group block overflow-hidden rounded-lg bg-neutral-900 shadow-lg transition-all duration-300 hover:scale-[1.02] hover:shadow-2xl">
								<div class="relative aspect-video overflow-hidden bg-neutral-800">
									{% if image %}
										{{ macros.image(image, { width: 600, height: 340 }, 'h-full w-full object-cover transition-transform duration-500 group-hover:scale-110') }}
									{% endif %}
									{% if show.showType.value ?? null %}
										<span class="absolute top-3 left-3 rounded-sm bg-neutral-700 px-2 py-1 text-xs font-bold uppercase">
											{{ show.showType.label }}
										</span>
									{% endif %}
								</div>
								<div class="p-4">
									<h3 class="h5 mb-2 text-white transition-colors group-hover:text-red-500">{{ show.title }}</h3>
									{% if show.eventDateTime %}
										<p class="text-sm text-neutral-400">{{ show.eventDateTime | date('d/m/Y') }}</p>
									{% endif %}
								</div>
							</a>
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}

	{# Empty state #}
	{% if not upcomingShows | length and not pastShows | length %}
		<section class="bg-black py-12 text-white lg:py-20">
			<div class="grid-container">
				<p class="text-center text-neutral-500">Aucun show pour le moment.</p>
			</div>
		</section>
	{% endif %}
{% endblock %}
