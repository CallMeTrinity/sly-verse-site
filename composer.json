{
	"require": {
		"craftcms/ckeditor": "^4.1.0",
		"craftcms/cms": "^5.0.0",
		"craftcms/feed-me": "6.11.0",
		"craftcms/guest-entries": "^4.0",
		"nystudio107/craft-vite": "^5.0.0",
		"vlucas/phpdotenv": "^5.6.0",
		"wbrowar/craft-admin-bar": "^5.0.0-beta.1"
	},
	"require-dev": {
		"yiisoft/yii2-shell": "^2.0.3"
	},
	"autoload": {
		"psr-4": {
			"modules\\": "modules/"
		}
	},
	"config": {
		"allow-plugins": {
			"craftcms/plugin-installer": true,
			"yiisoft/yii2-composer": true
		},
		"sort-packages": true,
		"optimize-autoloader": true,
		"platform": {
			"php": "8.4"
		}
	},
	"scripts": {
		"craft-update": [
			"@php craft install/check && php craft clear-caches/all --interactive=0 || exit 0",
			"@php craft install/check && php craft up --interactive=0 || exit 0"
		],
		"deploy-staging": [
			"composer install --no-interaction --prefer-dist --optimize-autoloader"
		],
		"deploy-production": [
			"composer craft-update"
		],
		"post-update-cmd": "@craft-update",
		"post-install-cmd": "@craft-update",
		"nuke": [
			"rm -rf vendor/ || true",
			"rm composer.lock || true",
			"composer clear-cache",
			"composer update"
		]
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://composer.craftcms.com",
			"canonical": false
		}
	]
}
