{% import '_includes/macros' as macros %}
{% set image = entry.mainImage.one() %}

{# Hero #}
<section class="relative overflow-hidden py-16 lg:py-24">
	{% if image %}
		<div class="absolute inset-0" data-hero-bg>
			{{ macros.image(image, { width: 1920 }, 'h-full w-full object-cover opacity-25') }}
		</div>
	{% endif %}
	<div class="from-bg via-bg/85 absolute inset-0 bg-linear-to-t to-black/40"></div>

	<div class="grid-container relative" x-data x-reveal>
		<div class="mb-5 flex flex-wrap gap-2">
			{% if entry.showType.value ?? null %}
				{{ macros.showTypeBadge(entry.showType) }}
			{% endif %}
			<span class="bg-surface-3 text-ink-muted rounded-sm px-2.5 py-1 text-[11px] font-extrabold tracking-wide uppercase">
				Terminé
			</span>
		</div>

		<h1 class="h1 mb-4">{{ entry.title }}</h1>

		{% if entry.eventDateTime %}
			<p class="text-gold text-lg font-bold tracking-wide uppercase">
				{{ entry.eventDateTime | date('l d F Y', 'Europe/Paris') | capitalize }}
			</p>
		{% endif %}

		{% if entry.videoUrl %}
			<div class="mt-7">
				<a href="{{ entry.videoUrl }}" target="_blank" rel="noopener noreferrer" class="btn-primary">
					Voir la vidéo du show
				</a>
			</div>
		{% endif %}
	</div>
</section>

{# Description #}
{% if entry.richContent | length %}
	<section class="bg-surface py-12 lg:py-16">
		<div class="grid-container" x-data x-reveal>
			<div class="prose text-ink-muted max-w-none">
				{{ entry.richContent }}
			</div>
		</div>
	</section>
{% endif %}

{# Match Card — Résultats #}
{% set matches = entry.matchCard.all() %}
{% if matches | length %}
	<section class="py-12 lg:py-20">
		<div class="grid-container">
			<div class="mb-8" x-data x-reveal>
				<span class="eyebrow">Ce qui s'est passé</span>
				<h2 class="h2 mb-0">Résultats</h2>
			</div>
			<div class="space-y-6">
				{% for match in matches %}
					<div x-data x-reveal.delay style="--i: {{ loop.index }}">
						{% include '_includes/_match-card' with { match: match, showResults: true } only %}
					</div>
				{% endfor %}
			</div>
		</div>
	</section>
{% endif %}

{# Vidéo embed #}
{% if entry.videoUrl %}
	<section class="bg-surface py-12 lg:py-20">
		<div class="grid-container">
			<div class="mb-8">
				<span class="eyebrow">Replay</span>
				<h2 class="h2 mb-0">Vidéo du show</h2>
			</div>
			{% include '_includes/_video-embed' with { url: entry.videoUrl } only %}
		</div>
	</section>
{% endif %}
