{% extends '_layout' %}

{% set seoTitle = 'Clips' %}
{% set seoDescription = 'Les meilleurs moments de la Sly Wrestling Universe en vidéo.' %}

{% block content %}
	{% set clips = craft.entries.section('clips').orderBy('postDate desc').all() %}

	{# Page Header #}
	<section class="bg-surface py-16 text-white lg:py-24">
		<div class="grid-container">
			<h1 class="h1 text-center tracking-tight uppercase">Clips</h1>
		</div>
	</section>

	{# Clips Grid #}
	{% if clips|length %}
		<section class="bg-surface py-8 text-white lg:py-14">
			<div class="grid-container">
				<div class="grid-row">
					{% for clip in clips %}
						<div
							class="grid-col mb-4 w-full sm:w-1/2 lg:mb-6 lg:w-1/3"
							x-data
							x-reveal.delay
							style="--i: {{ loop.index }}"
						>
							{% include '_includes/_clip-card' with {
								clip: clip
							} only %}
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% else %}
		<section class="bg-surface py-12 text-white lg:py-20">
			<div class="grid-container">
				<p class="text-ink-faint text-center">
					Aucun clip pour le moment.
				</p>
			</div>
		</section>
	{% endif %}
{% endblock %}
