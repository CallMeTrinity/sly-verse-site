{% extends '_layout' %}

{% block content %}
	{% import '_includes/macros' as macros %}

	{% set articles = craft.entries.section('articles').orderBy('postDate desc').all() %}

	{# Page Header #}
	<section class="bg-linear-to-br from-black via-neutral-900 to-neutral-800 py-16 text-white lg:py-24">
		<div class="grid-container">
			<h1 class="h1 text-center tracking-tight uppercase">Articles</h1>
		</div>
	</section>

	{# Articles Grid #}
	{% if articles | length %}
		<section class="bg-neutral-950 py-6 text-white lg:py-12">
			<div class="grid-container">
				<div class="grid-row">
					{% for article in articles %}
						<div class="grid-col mb-4 w-full md:w-1/2 lg:w-1/3 lg:mb-6" x-data x-reveal.delay style="--i: {{ loop.index }}">
							{% include '_includes/_article-card' with { article: article } only %}
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% else %}
		<section class="bg-neutral-950 py-12 text-white lg:py-20">
			<div class="grid-container">
				<p class="text-center text-neutral-500">Aucun article pour le moment.</p>
			</div>
		</section>
	{% endif %}
{% endblock %}
