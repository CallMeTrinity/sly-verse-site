{% import '_includes/macros' as macros %}
{% set image = entry.mainImage.one() %}

{# Hero #}
<section class="relative bg-linear-to-br from-black via-neutral-900 to-neutral-800 py-16 text-white lg:py-24">
	{% if image %}
		<div class="absolute inset-0 overflow-hidden">
			{{ macros.image(image, { width: 1920 }, 'h-full w-full object-cover opacity-20') }}
			<div class="absolute inset-0 bg-linear-to-t from-black via-black/80 to-black/50"></div>
		</div>
	{% endif %}
	<div class="grid-container relative" x-data x-reveal>
		<div class="mb-4 flex flex-wrap gap-2">
			{% if entry.showType.value ?? null %}
				<span class="rounded-sm bg-red-600 px-3 py-1 text-xs font-bold uppercase">
					{{ entry.showType.label }}
				</span>
			{% endif %}
			<span class="rounded-sm bg-neutral-700 px-3 py-1 text-xs font-bold uppercase">Terminé</span>
		</div>

		<h1 class="h1 mb-4 tracking-tight uppercase">{{ entry.title }}</h1>

		{% if entry.eventDateTime %}
			<p class="text-lg text-neutral-300">
				{{ entry.eventDateTime | date('l d F Y', 'Europe/Paris') | capitalize }}
			</p>
		{% endif %}

		{% if entry.videoUrl %}
			<div class="mt-6">
				<a
					href="{{ entry.videoUrl }}"
					target="_blank"
					rel="noopener noreferrer"
					class="btn border-red-600 bg-red-600 text-white hover:border-red-700 hover:bg-red-700"
				>
					Voir la vidéo du show
				</a>
			</div>
		{% endif %}
	</div>
</section>

{# Description #}
{% if entry.richContent | length %}
	<section class="bg-neutral-950 py-12 text-white lg:py-20">
		<div class="grid-container" x-data x-reveal>
			<div class="prose prose-invert max-w-none text-neutral-300">
				{{ entry.richContent }}
			</div>
		</div>
	</section>
{% endif %}

{# Match Card — Résultats #}
{% set matches = entry.matchCard.all() %}
{% if matches | length %}
	<section class="bg-black py-12 text-white lg:py-20">
		<div class="grid-container">
			<h2 class="h3 mb-8 uppercase" x-data x-reveal>Résultats</h2>
			<div class="space-y-4">
				{% for match in matches %}
					{% set winners = match.vainqueur.all() %}
					{% set winnerIds = winners | map(w => w.id) %}
					<div class="rounded-lg border border-white/10 bg-neutral-900 p-6" x-data x-reveal.delay style="--i: {{ loop.index }}">
						{# Match type & stipulation badges #}
						<div class="mb-3 flex flex-wrap items-center gap-2">
							{% if match.matchType %}
								<span class="rounded-sm bg-neutral-800 px-2 py-1 text-xs font-semibold uppercase text-neutral-400">
									{{ match.matchType }}
								</span>
							{% endif %}
							{% if match.stipulation %}
								<span class="rounded-sm bg-red-900/50 px-2 py-1 text-xs font-semibold uppercase text-red-400">
									{{ match.stipulation }}
								</span>
							{% endif %}
						</div>

						<h3 class="h5 mb-3 text-white">{{ match.matchTitle ?? match.title }}</h3>

						{# Participants — vainqueurs mis en avant #}
						{% set fighters = match.fighters.all() %}
						{% if fighters | length %}
							<div class="mb-3 flex flex-wrap gap-2">
								{% for fighter in fighters %}
									{% set isWinner = fighter.id in winnerIds %}
									<a
										href="{{ fighter.url }}"
										class="rounded-full px-3 py-1 text-sm font-semibold transition-colors {{ isWinner ? 'bg-yellow-400 text-black hover:bg-yellow-300' : 'bg-neutral-800 text-white hover:bg-neutral-700' }}"
									>
										{% if isWinner %}★ {% endif %}{{ fighter.title }}
									</a>
								{% endfor %}
							</div>
						{% endif %}

						{# Résultat #}
						{% if match.results | length %}
							<div class="mt-4 border-t border-white/10 pt-4">
								<span class="mb-2 block text-xs font-semibold tracking-wider text-neutral-500 uppercase">Résultat</span>
								<div class="prose prose-invert text-sm text-neutral-300">{{ match.results }}</div>
							</div>
						{% endif %}

						{# Vainqueurs — bannière dorée #}
						{% if winners | length %}
							<div class="mt-4 flex flex-wrap items-center gap-2 rounded-md bg-yellow-400/10 px-4 py-2 ring-1 ring-yellow-400/30">
								<span class="text-yellow-400">★</span>
								<span class="text-xs font-semibold tracking-wider text-neutral-400 uppercase">{{ winners | length > 1 ? 'Vainqueurs' : 'Vainqueur' }}</span>
								{% for winner in winners %}
									<a href="{{ winner.url }}" class="font-bold text-yellow-400 hover:text-yellow-300">
										{{ winner.title }}
									</a>
									{% if not loop.last %}<span class="text-yellow-400/50">&</span>{% endif %}
								{% endfor %}
							</div>
						{% endif %}
					</div>
				{% endfor %}
			</div>
		</div>
	</section>
{% endif %}

{# Vidéo embed #}
{% if entry.videoUrl %}
	{% set videoUrl = entry.videoUrl %}
	{% if 'youtube.com/watch?v=' in videoUrl %}
		{% set videoId = videoUrl | split('v=') | last | split('&') | first %}
		{% set embedUrl = 'https://www.youtube.com/embed/' ~ videoId %}
	{% elseif 'youtu.be/' in videoUrl %}
		{% set videoId = videoUrl | split('youtu.be/') | last | split('?') | first %}
		{% set embedUrl = 'https://www.youtube.com/embed/' ~ videoId %}
	{% else %}
		{% set embedUrl = null %}
	{% endif %}

	{% if embedUrl %}
		<section class="bg-neutral-950 py-12 text-white lg:py-20">
			<div class="grid-container">
				<h2 class="h3 mb-8 uppercase">Vidéo du show</h2>
				<div class="aspect-video overflow-hidden rounded-lg bg-neutral-900">
					<iframe
						src="{{ embedUrl }}"
						class="h-full w-full"
						frameborder="0"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
						allowfullscreen
					></iframe>
				</div>
			</div>
		</section>
	{% endif %}
{% endif %}
