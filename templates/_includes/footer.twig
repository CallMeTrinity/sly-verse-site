{% import '_includes/macros' as macros %}
{% set homepage = craft.entries.section('pageAccueil').one() %}

<footer class="border-line bg-surface border-t">
	<div class="grid-container py-12 lg:py-16">
		<div class="flex flex-wrap justify-between gap-10">
			{# Logo + tagline #}
			<div class="max-w-xs">
				<a href="/" class="flex items-center gap-2.5" aria-label="Accueil SWU">
					<img src="/SWU.png" alt="" class="size-8 object-contain" width="32" height="32" />
					<span class="font-display text-sm font-bold tracking-wide uppercase">Sly Wrestling Universe</span>
				</a>
				<p class="text-ink-faint mt-4 text-sm leading-relaxed">
					L'univers du catch virtuel sur WWE 2K. Superstars, rivalités et Premium Live Events.
				</p>
			</div>

			<div class="flex flex-wrap gap-12 lg:gap-20">
				{# Navigation #}
				<div>
					<h3 class="text-ink-faint mb-4 text-xs font-extrabold tracking-widest uppercase">Explorer</h3>
					{% include '_includes/_nav' with {
						variant: 'footer'
					} %}
				</div>

				{# Réseaux sociaux #}
				{% if homepage %}
					{% set socials = homepage.socialMedia.all() %}
					{% if socials|length %}
						<div>
							<h3 class="text-ink-faint mb-4 text-xs font-extrabold tracking-widest uppercase">Suivre</h3>
							<div class="flex flex-wrap gap-2.5">
								{% for social in socials %}
									{% set image = social.linkImage.one() %}
									<a
										href="{{ social.basicLink.value }}"
										target="_blank"
										rel="noopener noreferrer"
										class="border-line text-ink-muted hover:border-gold hover:text-gold flex size-9 items-center justify-center rounded-md border transition-colors"
										title="{{ social.title ?? image.title ?? '' }}"
										aria-label="{{ social.title ?? image.title ?? 'Réseau social' }}"
									>
										{{ macros.socialIcon(social.basicLink.value, 'size-4') }}
									</a>
								{% endfor %}
							</div>
						</div>
					{% endif %}
				{% endif %}
			</div>
		</div>
	</div>

	{# Bottom bar #}
	<div class="border-line border-t">
		<div class="grid-container flex flex-col items-center justify-between gap-3 py-6 sm:flex-row">
			<p class="text-ink-faint text-xs">
				&copy; {{ now|date('Y') }} SWU — Sly Wrestling Universe. Fédération de catch fictive, à but non lucratif.
			</p>
			<p class="text-ink-faint/70 text-xs">
				Propulsé par Craft CMS
			</p>
		</div>
	</div>
</footer>
