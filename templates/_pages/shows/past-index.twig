{% extends '_layout' %}

{% block content %}
	{% import '_includes/macros' as macros %}
	{% set shows = craft.entries.section('shows').showStatus('termine').orderBy('eventDateTime desc').all() %}

	{# Page Header #}
	<section class="bg-linear-to-br from-black via-neutral-900 to-neutral-800 py-16 text-white lg:py-24">
		<div class="grid-container">
			<h1 class="h1 text-center tracking-tight uppercase">Résultats</h1>
			<p class="mt-4 text-center text-neutral-400">Historique des shows passés</p>
		</div>
	</section>

	{# Shows Timeline #}
	<section class="bg-black py-12 text-white lg:py-20">
		<div class="grid-container">
			{% if shows | length %}
				{# Group by year #}
				{% set currentYear = null %}
				{% for show in shows %}
					{% set showYear = show.eventDateTime ? show.eventDateTime | date('Y') : null %}

					{# Year separator #}
					{% if showYear and showYear != currentYear %}
						{% if not loop.first %}
							</div>{# close previous year list #}
						{% endif %}
						<h2 class="mb-6 {{ loop.first ? '' : 'mt-12' }} text-2xl font-black tracking-tight text-neutral-500 uppercase">
							{{ showYear }}
						</h2>
						<div class="space-y-4">
						{% set currentYear = showYear %}
					{% endif %}

					{# Show card — horizontal layout #}
					{% set image = show.mainImage.one() %}
					<a
						href="{{ show.url }}"
						class="group flex overflow-hidden rounded-lg bg-neutral-900 shadow-lg transition-all duration-300 hover:bg-neutral-800 hover:shadow-2xl"
					>
						{# Thumbnail #}
						<div class="relative hidden aspect-video w-48 shrink-0 overflow-hidden bg-neutral-800 sm:block md:w-64">
							{% if image %}
								{{ macros.image(image, { width: 400, height: 225 }, 'h-full w-full object-cover transition-transform duration-500 group-hover:scale-105') }}
							{% else %}
								<div class="flex h-full w-full items-center justify-center">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-neutral-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.069A1 1 0 0121 8.87v6.26a1 1 0 01-1.447.894L15 14M3 8a2 2 0 012-2h10a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8z" />
									</svg>
								</div>
							{% endif %}
						</div>

						{# Info #}
						<div class="flex flex-1 flex-col justify-center p-4 md:p-6">
							<div class="mb-2 flex flex-wrap items-center gap-2">
								{% if show.showType.value ?? null %}
									<span class="rounded-sm bg-neutral-700 px-2 py-0.5 text-xs font-bold uppercase text-neutral-300">
										{{ show.showType.label }}
									</span>
								{% endif %}
								{% if show.eventDateTime %}
									<span class="text-xs text-neutral-500">
										{{ show.eventDateTime | date('d F Y', 'Europe/Paris') }}
									</span>
								{% endif %}
							</div>
							<h3 class="h5 text-white transition-colors group-hover:text-red-500">{{ show.title }}</h3>

							{# Match count hint #}
							{% set matchCount = show.matchCard.count() %}
							{% if matchCount %}
								<p class="mt-2 text-sm text-neutral-500">
									{{ matchCount }} match{{ matchCount > 1 ? 's' : '' }}
								</p>
							{% endif %}
						</div>

						{# Arrow #}
						<div class="flex shrink-0 items-center px-4 text-neutral-600 transition-colors group-hover:text-red-500">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
							</svg>
						</div>
					</a>
				{% endfor %}
				</div>{# close last year list #}
			{% else %}
				<p class="py-12 text-center text-neutral-500">Aucun résultat disponible pour le moment.</p>
			{% endif %}
		</div>
	</section>
{% endblock %}
