{% extends '_layout' %}

{% block content %}
	{% import '_includes/macros' as macros %}
	{% set image = entry.profileImage.one() %}
	{% set rosterEntry = entry.roster.one() ?? null %}

	{# Hero Section #}
	<section class="relative bg-linear-to-br from-black via-neutral-900 to-neutral-800 py-16 text-white lg:py-24">
		<div class="grid-container">
			<div class="grid-row items-center">
				{# Profile Image #}
				<div class="grid-col mb-8 w-full lg:mb-0 lg:w-5/12">
					<div class="relative mx-auto aspect-[3/4] max-w-md overflow-hidden rounded-lg bg-neutral-800 shadow-2xl lg:mx-0">
						{% if image %}
							{{ macros.image(image, { width: 800, height: 1067 }, 'h-full w-full object-cover') }}
						{% else %}
							<div class="flex h-full w-full items-center justify-center text-neutral-600">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-24 w-24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
								</svg>
							</div>
						{% endif %}
					</div>
				</div>

				{# Info #}
				<div class="grid-col w-full lg:w-7/12">
					{# Badges #}
					<div class="mb-4 flex flex-wrap gap-2">
						{% if entry.alignment.value ?? null %}
							{% set alignmentColors = {
								'face': 'bg-green-600',
								'heel': 'bg-red-600',
								'tweener': 'bg-neutral-500',
							} %}
							<span class="rounded-full px-3 py-1 text-xs font-bold uppercase {{ alignmentColors[entry.alignment.value] ?? 'bg-neutral-500' }}">
								{{ entry.alignment.label }}
							</span>
						{% endif %}
						{% if rosterEntry %}
							<span class="rounded-full bg-neutral-700 px-3 py-1 text-xs font-bold uppercase">
								{{ rosterEntry.title }}
							</span>
						{% endif %}
						{% if not entry.isActive %}
							<span class="rounded-full bg-neutral-600 px-3 py-1 text-xs font-bold uppercase">
								Inactif
							</span>
						{% endif %}
					</div>

					<h1 class="h1 mb-4 tracking-tight uppercase">{{ entry.title }}</h1>

					{% if entry.shortDescription %}
						<p class="mb-8 text-lg text-neutral-300">{{ entry.shortDescription }}</p>
					{% endif %}

					{# Stats #}
					<div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
						{% if entry.hometown %}
							<div class="rounded-lg bg-white/5 p-4">
								<span class="mb-1 block text-xs font-semibold tracking-wider text-neutral-500 uppercase">Ville</span>
								<span class="text-sm text-white">{{ entry.hometown }}</span>
							</div>
						{% endif %}
						{% if entry.homeCountry %}
							<div class="rounded-lg bg-white/5 p-4">
								<span class="mb-1 block text-xs font-semibold tracking-wider text-neutral-500 uppercase">Pays</span>
								<span class="text-sm text-white">{{ entry.homeCountry }}</span>
							</div>
						{% endif %}
						{% if entry.height %}
							<div class="rounded-lg bg-white/5 p-4">
								<span class="mb-1 block text-xs font-semibold tracking-wider text-neutral-500 uppercase">Taille</span>
								<span class="text-sm text-white">{{ entry.height }}</span>
							</div>
						{% endif %}
						{% if entry.weight %}
							<div class="rounded-lg bg-white/5 p-4">
								<span class="mb-1 block text-xs font-semibold tracking-wider text-neutral-500 uppercase">Poids</span>
								<span class="text-sm text-white">{{ entry.weight }}</span>
							</div>
						{% endif %}
						{% if entry.finisher %}
							<div class="rounded-lg bg-white/5 p-4">
								<span class="mb-1 block text-xs font-semibold tracking-wider text-neutral-500 uppercase">Finisher</span>
								<span class="text-sm text-white">{{ entry.finisher }}</span>
							</div>
						{% endif %}
					</div>
				</div>
			</div>
		</div>
	</section>

	{# Biography #}
	{% if entry.richContent | length %}
		<section class="bg-neutral-950 py-12 text-white lg:py-20">
			<div class="grid-container">
				<h2 class="h3 mb-8 uppercase">Biographie</h2>
				<div class="prose prose-invert max-w-none text-neutral-300">
					{{ entry.richContent }}
				</div>
			</div>
		</section>
	{% endif %}

	{# Championships #}
	{% set championships = entry.championships.all() %}
	{% if championships | length %}
		<section class="bg-black py-12 text-white lg:py-20">
			<div class="grid-container">
				<h2 class="h3 mb-8 uppercase">Palmar&egrave;s</h2>
				<div class="grid-row">
					{% for championship in championships %}
						<div class="grid-col mb-4 w-full sm:w-1/2 lg:w-1/3">
							<div class="rounded-lg border border-white/10 bg-neutral-900 p-6">
								<h3 class="h5 mb-2 text-white">{{ championship.title }}</h3>
							</div>
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}

	{# Image Gallery #}
	{% set gallery = entry.imageGallery.all() %}
	{% if gallery | length %}
		<section class="bg-neutral-950 py-12 text-white lg:py-20">
			<div class="grid-container">
				<h2 class="h3 mb-8 uppercase">Galerie</h2>
				<div class="grid-row">
					{% for image in gallery %}
						<div class="grid-col mb-4 w-full sm:w-1/2 md:w-1/3">
							<div class="aspect-video overflow-hidden rounded-lg bg-neutral-800">
								{{ macros.image(image, { width: 600, height: 400 }, 'h-full w-full object-cover') }}
							</div>
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}
{% endblock %}
