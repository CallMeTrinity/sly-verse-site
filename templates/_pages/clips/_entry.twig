    {% extends '_layout' %}

{% block content %}
	{% import '_includes/macros' as macros %}

	{# Video Player #}
	<section class="bg-black py-8 text-white lg:py-14">
		<div class="grid-container">
			<div class="mx-auto max-w-5xl" x-data x-reveal>
				{% set videoUrl = entry.videoUrl.value ?? entry.videoUrl %}
				{% if videoUrl %}
					{% include '_includes/_video-embed' with { url: videoUrl } only %}
				{% endif %}
			</div>
		</div>
	</section>

	{# Clip Info #}
	<section class="bg-neutral-950 py-8 text-white lg:py-14">
		<div class="grid-container mx-auto max-w-5xl" x-data x-reveal>
			<h1 class="h2 mb-4 tracking-tight uppercase">{{ entry.title }}</h1>
			<p class="text-sm text-neutral-500">{{ entry.postDate | date('d/m/Y') }}</p>

			{# Related Superstars #}
			{% set superstars = entry.relatedSuperstars.all() ?? [] %}
			{% if superstars | length %}
				<div class="mt-6 flex flex-wrap gap-2">
					{% for superstar in superstars %}
						{% set profileImage = superstar.profileImage.one() ?? null %}
						<a href="{{ superstar.url }}" class="flex items-center gap-2 rounded-full bg-white/5 py-1 pr-3 pl-1 transition-colors hover:bg-white/10">
							{% if profileImage %}
								<div class="h-7 w-7 overflow-hidden rounded-full bg-neutral-800">
									{{ macros.image(profileImage, { width: 56, height: 56 }, 'h-full w-full object-cover') }}
								</div>
							{% endif %}
							<span class="text-sm font-medium text-white">{{ superstar.title }}</span>
						</a>
					{% endfor %}
				</div>
			{% endif %}
		</div>
	</section>

	{# More Clips #}
	{% set moreClips = craft.entries.section('clips').id('not ' ~ entry.id).orderBy('postDate desc').limit(3).all() %}
	{% if moreClips | length %}
		<section class="bg-black py-8 text-white lg:py-14">
			<div class="grid-container">
				<h2 class="h3 mb-6 uppercase" x-data x-reveal>Autres clips</h2>
				<div class="grid-row">
					{% for clip in moreClips %}
						<div class="grid-col mb-4 w-full sm:w-1/2 lg:w-1/3 lg:mb-6" x-data x-reveal.delay style="--i: {{ loop.index }}">
							{% include '_includes/_clip-card' with { clip: clip } only %}
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}
{% endblock %}
