{% extends '_layout' %}

{% block content %}
	{% import '_includes/macros' as macros %}
	{% set image = entry.profileImage.one() %}
	{% set rosterEntry = entry.roster.one() ?? null %}

	{# Hero Section #}
	<section class="bg-surface relative py-16 text-white lg:py-24">
		<div class="grid-container">
			<div class="grid-row items-center">
				{# Profile Image #}
				<div class="grid-col mb-8 w-full lg:mb-0 lg:w-5/12" x-data x-reveal>
					<div
						class="bg-surface-3 relative mx-auto aspect-[3/4] max-w-md overflow-hidden rounded-lg shadow-2xl lg:mx-0"
					>
						{% if image %}
							{{
								macros.image(
									image,
									{
										width: 800,
										height: 1067
									},
									'h-full w-full object-cover'
								)
							}}
						{% else %}
							<div class="text-ink-faint flex h-full w-full items-center justify-center">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="h-24 w-24"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="1"
										d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
									/>
								</svg>
							</div>
						{% endif %}
					</div>
				</div>

				{# Info #}
				<div class="grid-col w-full lg:w-7/12" x-data x-reveal.delay style="--i: 2">
					{# Badges #}
					<div class="mb-4 flex flex-wrap gap-2">
						{% if entry.alignment.value ?? null %}
							{% set alignmentColors = {
								face: 'bg-face',
								heel: 'bg-blue',
								tweener: 'bg-tweener'
							} %}
							<span
								class="rounded-full px-3 py-1 text-xs font-bold uppercase {{
								alignmentColors[entry.alignment.value]
									?? 'bg-tweener'
								}}"
							>
								{{ entry.alignment.label }}
							</span>
						{% endif %}
						{% if rosterEntry %}
							<span class="bg-surface-3 rounded-full px-3 py-1 text-xs font-bold uppercase">
								{{ rosterEntry.title }}
							</span>
						{% endif %}
						{% if not entry.isActive %}
							<span class="bg-tweener rounded-full px-3 py-1 text-xs font-bold uppercase">Inactif</span>
						{% endif %}
					</div>

					<h1 class="h1 mb-4 tracking-tight uppercase">{{ entry.title }}</h1>

					{% if entry.shortDescription %}
						<p class="text-ink-muted mb-8 text-lg">
							{{ entry.shortDescription }}
						</p>
					{% endif %}

					{# Stats #}
					<div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
						{% if entry.hometown %}
							<div class="rounded-lg bg-white/5 p-4">
								<span class="text-ink-faint mb-1 block text-xs font-semibold tracking-wider uppercase">
									Ville
								</span>
								<span class="text-sm text-white">{{ entry.hometown }}</span>
							</div>
						{% endif %}
						{% if entry.homeCountry %}
							<div class="rounded-lg bg-white/5 p-4">
								<span class="text-ink-faint mb-1 block text-xs font-semibold tracking-wider uppercase">
									Pays
								</span>
								<span class="text-sm text-white">{{ entry.homeCountry }}</span>
							</div>
						{% endif %}
						{% if entry.height %}
							<div class="rounded-lg bg-white/5 p-4">
								<span class="text-ink-faint mb-1 block text-xs font-semibold tracking-wider uppercase">
									Taille
								</span>
								<span class="text-sm text-white">{{ entry.height }}</span>
							</div>
						{% endif %}
						{% if entry.weight %}
							<div class="rounded-lg bg-white/5 p-4">
								<span class="text-ink-faint mb-1 block text-xs font-semibold tracking-wider uppercase">
									Poids
								</span>
								<span class="text-sm text-white">{{ entry.weight }}</span>
							</div>
						{% endif %}
						{% if entry.finisher %}
							<div class="rounded-lg bg-white/5 p-4">
								<span class="text-ink-faint mb-1 block text-xs font-semibold tracking-wider uppercase">
									Finisher
								</span>
								<span class="text-sm text-white">{{ entry.finisher }}</span>
							</div>
						{% endif %}
					</div>
				</div>
			</div>
		</div>
	</section>

	{# Biography #}
	{% if entry.richContent|length %}
		<section class="bg-surface py-12 text-white lg:py-20">
			<div class="grid-container" x-data x-reveal>
				<h2 class="h3 mb-8 uppercase">Biographie</h2>
				<div class="prose text-ink-muted max-w-none">
					{{ entry.richContent }}
				</div>
			</div>
		</section>
	{% endif %}

	{# Championships #}
	{% set championships = entry.championships.all() %}
	{% if championships|length %}
		{# Group championships by belt #}
		{% set grouped = {} %}
		{% for championship in championships %}
			{% set belt = championship.ceinture.one() %}
			{% set beltId = belt ? 'belt_' ~ belt.id : 'unknown' %}
			{% if grouped[beltId] is not defined %}
				{% set grouped =
					grouped|merge({
						(beltId): {
							belt: belt,
							ids: []
						}
					})
				%}
			{% endif %}
			{% set currentIds = grouped[beltId].ids %}
			{% set grouped =
				grouped|merge({
					(beltId): {
						belt: belt,
						ids: currentIds|merge([championship.id])
					}
				})
			%}
		{% endfor %}

		<section class="bg-bg py-12 text-white lg:py-20">
			<div class="grid-container">
				<h2 class="h3 mb-8 uppercase" x-data x-reveal>Palmar&egrave;s</h2>
				<div class="grid-row">
					{% for beltId, group in grouped %}
						{% set belt = group.belt %}
						{% set reigns = craft.entries.id(group.ids).orderBy('eventDateTime asc').all() %}
						{% set beltImage = belt ? belt.beltImage.one() : null %}
						{% set count = reigns|length %}
						<div
							class="grid-col mb-4 w-full sm:w-1/2 lg:w-1/3"
							x-data="{ open: false }"
							x-reveal.delay
							style="--i: {{ loop.index }}"
						>
							<div class="border-line bg-surface-2 rounded-lg border p-6">
								{% if beltImage %}
									{{
										macros.image(
											beltImage,
											{
												width: 400,
												height: 200
											},
											'mb-4 h-32 w-full object-contain'
										)
									}}
								{% endif %}
								{% if belt %}
									<h3 class="h5 mb-2 text-white">
										<a href="{{ belt.url }}" class="hover:text-gold transition-colors">{{ belt.title }}</a>
									</h3>
								{% endif %}
								<div class="text-ink-muted mt-2 flex items-center gap-2 text-sm">
									<span>{{ count }}x Champion</span>
									{% if count == 1 %}
										{% set reign = reigns|first %}
										<span class="text-ink-faint">—</span>
										{% if reign.eventDateTime %}
											<span class="font-semibold text-white">{{ reign.eventDateTime|date('Y') }}</span>
										{% endif %}
										{% if reign.datePerte %}
											<span class="text-ink-faint">→</span>
											<span class="font-semibold text-white">{{ reign.datePerte|date('Y') }}</span>
										{% elseif reign.eventDateTime %}
											<span
												class="text-gold rounded-full bg-yellow-500/20 px-2 py-0.5 text-xs font-semibold uppercase"
											>
												En cours
											</span>
										{% endif %}
									{% endif %}
								</div>
								{% if count > 1 %}
									{# Multiple reigns: expandable details #}
									<button
										@click="open = !open"
										class="text-ink-faint mt-3 flex items-center gap-1 text-xs font-semibold uppercase transition-colors hover:text-white"
									>
										<span x-text="open ? 'Masquer' : 'Voir le détail'"></span>
										<svg
											xmlns="http://www.w3.org/2000/svg"
											class="h-3.5 w-3.5 transition-transform"
											:class="open && 'rotate-180'"
											fill="none"
											viewBox="0 0 24 24"
											stroke="currentColor"
										>
											<path
												stroke-linecap="round"
												stroke-linejoin="round"
												stroke-width="2"
												d="M19 9l-7 7-7-7"
											/>
										</svg>
									</button>
									<div x-show="open" x-transition class="border-line mt-3 space-y-2 border-t pt-3">
										{% for reign in reigns %}
											<div class="flex items-center justify-between text-sm">
												<span class="text-ink-faint">R&egrave;gne {{ loop.index }}</span>
												<div class="flex items-center gap-1.5">
													{% if reign.eventDateTime %}
														<span class="font-semibold text-white">
															{{ reign.eventDateTime|date('Y') }}
														</span>
														<span class="text-ink-faint text-xs">
															({{ reign.eventDateTime|date('d/m') }})
														</span>
													{% endif %}
													{% if reign.datePerte %}
														<span class="text-ink-faint">→</span>
														<span class="font-semibold text-white">{{ reign.datePerte|date('Y') }}</span>
														<span class="text-ink-faint text-xs">
															({{ reign.datePerte|date('d/m') }})
														</span>
													{% elseif reign.eventDateTime %}
														<span
															class="text-gold ml-1 rounded-full bg-yellow-500/20 px-2 py-0.5 text-xs font-semibold uppercase"
														>
															En cours
														</span>
													{% endif %}
												</div>
											</div>
										{% endfor %}
									</div>
								{% endif %}
							</div>
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}

	{# Clips #}
	{% set clips =
		craft.entries.section('clips').relatedTo({
			targetElement: entry,
			field: 'relatedSuperstars'
		}).orderBy(
			'postDate desc'
		).all()
	%}
	{% if clips|length %}
		<section class="bg-surface py-12 text-white lg:py-20">
			<div class="grid-container">
				<h2 class="h3 mb-8 uppercase" x-data x-reveal>Clips</h2>
				<div class="grid-row">
					{% for clip in clips %}
						<div
							class="grid-col mb-4 w-full sm:w-1/2 lg:mb-6 lg:w-1/3"
							x-data
							x-reveal.delay
							style="--i: {{ loop.index }}"
						>
							{% include '_includes/_clip-card' with {
								clip: clip
							} only %}
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}

	{# Image Gallery #}
	{% set gallery = entry.imageGallery.all() %}
	{% if gallery|length %}
		<section class="bg-surface py-12 text-white lg:py-20">
			<div class="grid-container">
				<h2 class="h3 mb-8 uppercase" x-data x-reveal>Galerie</h2>
				<div class="grid-row">
					{% for image in gallery %}
						<div
							class="grid-col mb-4 w-full sm:w-1/2 md:w-1/3"
							x-data
							x-reveal.delay
							style="--i: {{ loop.index }}"
						>
							<div class="bg-surface-3 aspect-video overflow-hidden rounded-lg">
								{{
									macros.image(
										image,
										{
											width: 600,
											height: 400
										},
										'h-full w-full object-cover'
									)
								}}
							</div>
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}
{% endblock %}
