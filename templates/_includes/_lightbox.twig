{# Lightbox Alpine partagée #}
{# À inclure dans un conteneur x-data="lightbox(images)" (cf. src/js/app.js), images = [{ src, alt }] #}
<template x-teleport="body">
	<div
		x-show="lightboxOpen"
		x-cloak
		x-trap.noscroll="lightboxOpen"
		x-transition:enter="transition ease-out duration-200"
		x-transition:enter-start="opacity-0"
		x-transition:enter-end="opacity-100"
		x-transition:leave="transition ease-in duration-150"
		x-transition:leave-start="opacity-100"
		x-transition:leave-end="opacity-0"
		x-on:keydown.escape.window="close()"
		x-on:keydown.left.window="lightboxOpen && prev()"
		x-on:keydown.right.window="lightboxOpen && next()"
		class="fixed inset-0 z-50 flex items-center justify-center bg-black/95 p-4"
		x-on:click.self="close()"
		role="dialog"
		aria-modal="true"
		aria-label="Visionneuse d'images"
	>
		<button
			type="button"
			x-on:click="close()"
			class="absolute top-4 right-4 text-white/70 transition-colors hover:text-white"
			aria-label="Fermer"
		>
			<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
			</svg>
		</button>

		<button
			type="button"
			x-show="images.length > 1"
			x-on:click="prev()"
			class="absolute left-4 text-white/70 transition-colors hover:text-white"
			aria-label="Image précédente"
		>
			<svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
			</svg>
		</button>

		<img
			x-bind:src="current.src"
			x-bind:alt="current.alt"
			class="max-h-[85vh] max-w-[90vw] rounded-lg object-contain shadow-2xl"
		/>

		<button
			type="button"
			x-show="images.length > 1"
			x-on:click="next()"
			class="absolute right-4 text-white/70 transition-colors hover:text-white"
			aria-label="Image suivante"
		>
			<svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
			</svg>
		</button>

		<div
			x-show="images.length > 1"
			class="absolute bottom-4 left-1/2 -translate-x-1/2 rounded-full bg-black/70 px-3 py-1 text-sm text-white/70"
		>
			<span x-text="(index + 1) + ' / ' + images.length"></span>
		</div>
	</div>
</template>
