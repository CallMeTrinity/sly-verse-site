{% extends '_layout' %}

{% set seoImage = entry.beltImage.one() %}
{% if seoImage %}
	{% set pageImage = seoImage.getUrl({ width: 1200 }) %}
{% endif %}

{% block content %}
	{% import '_includes/macros' as macros %}
	{% set beltImage = entry.beltImage.one() %}

	{# Hero #}
	<section class="bg-surface relative py-16 text-white lg:py-24">
		<div class="grid-container">
			<div class="grid-row items-center">
				{% if beltImage %}
					<div class="grid-col mb-8 w-full lg:mb-0 lg:w-5/12" x-data x-reveal>
						{{
							macros.image(
								beltImage,
								{
									width: 600,
									height: 400
								},
								'mx-auto max-w-xs object-contain drop-shadow-2xl'
							)
						}}
					</div>
				{% endif %}
				<div class="grid-col w-full {{ beltImage ? 'lg:w-7/12' : '' }}" x-data x-reveal.delay style="--i: 2">
					<h1 class="h1 mb-4 tracking-tight uppercase">{{ entry.title }}</h1>
				</div>
			</div>
		</div>
	</section>

	{# Historique des règnes #}
	{% set reigns = craft.entries().type('championships').ceinture(entry.id).orderBy('eventDateTime asc').all() %}

	{% if reigns|length %}
		<section class="bg-surface py-12 text-white lg:py-20">
			<div class="grid-container" x-data x-reveal>
				<h2 class="h3 mb-8 uppercase">Historique des r&egrave;gnes</h2>
				<div class="border-line overflow-hidden rounded-lg border">
					<table class="w-full text-sm">
						<thead class="text-ink-muted bg-white/5 text-xs font-semibold tracking-wider uppercase">
							<tr>
								<th class="px-6 py-3 text-left">Superstar</th>
								<th class="px-6 py-3 text-left">Date de victoire</th>
								<th class="px-6 py-3 text-left">Date de perte</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-white/5">
							{% for reign in reigns %}
								{% set superstar = reign.owner %}
								<tr class="bg-surface-2 hover:bg-surface-3 transition-colors">
									<td class="px-6 py-4">
										{% if superstar %}
											<a href="{{ superstar.url }}" class="hover:text-gold font-semibold text-white">
												{{ superstar.title }}
											</a>
										{% endif %}
									</td>
									<td class="text-ink-muted px-6 py-4">
										{{ reign.eventDateTime ? reign.eventDateTime|date('d/m/Y') : '—' }}
									</td>
									<td class="px-6 py-4">
										{% if reign.datePerte %}
											<span class="text-ink-muted">{{ reign.datePerte|date('d/m/Y') }}</span>
										{% else %}
											<span
												class="text-gold rounded-full bg-yellow-500/20 px-2 py-0.5 text-xs font-semibold uppercase"
											>
												En cours
											</span>
										{% endif %}
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>
		</section>
	{% endif %}
{% endblock %}
