{% extends '_layout' %}

{% set seoImage = entry.profileImage.one() %}
{% if seoImage %}
	{% set pageImage = seoImage.getUrl({ width: 1200 }) %}
{% endif %}
{% if entry.shortDescription %}
	{% set pageDescription = entry.shortDescription|striptags|trim %}
{% endif %}

{% block content %}
	{% import '_includes/macros' as macros %}
	{% set image = entry.profileImage.one() %}

	<section class="bg-surface relative py-16 text-white lg:py-24">
		<div class="grid-container">
			<a
				href="/superstars?tab=personnel"
				class="text-ink-muted hover:text-gold mb-8 inline-block text-sm font-bold uppercase transition-colors"
			>
				&larr; Tout le personnel
			</a>
			<div class="grid items-center gap-10 lg:grid-cols-12">
				{% if image %}
					<div class="lg:col-span-5" x-data x-reveal>
						<div
							class="bg-surface-3 relative mx-auto aspect-[3/4] max-w-md overflow-hidden rounded-lg shadow-2xl lg:mx-0"
						>
							{{
								macros.image(
									image,
									{
										width: 800,
										height: 1067
									},
									'h-full w-full object-cover'
								)
							}}
						</div>
					</div>
				{% endif %}

				<div class="{{ image ? 'lg:col-span-7' : 'lg:col-span-12' }}" x-data x-reveal.delay style="--i: 2">
					{% if entry.staffRole.value ?? null %}
						<span class="bg-gold mb-4 inline-block rounded-full px-3 py-1 text-xs font-bold text-black uppercase">
							{{ entry.staffRole.label }}
						</span>
					{% endif %}
					<h1 class="h1 mb-4 tracking-tight uppercase">{{ entry.title }}</h1>
					{% if entry.shortDescription %}
						<p class="text-ink-muted text-lg">{{ entry.shortDescription }}</p>
					{% endif %}
				</div>
			</div>
		</div>
	</section>

	{% if entry.richContent|length %}
		<section class="bg-bg py-12 text-white lg:py-20">
			<div class="grid-container" x-data x-reveal>
				<h2 class="h3 mb-8 uppercase">Biographie</h2>
				<div class="prose text-ink-muted max-w-none">
					{{ entry.richContent }}
				</div>
			</div>
		</section>
	{% endif %}
{% endblock %}
