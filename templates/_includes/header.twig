<header class="border-line/60 bg-bg/90 sticky top-0 z-50 border-b backdrop-blur-md">
	<div class="grid-container">
		<div class="flex items-center justify-between py-2.5">
			{# Logo #}
			<a href="/" class="flex items-center gap-2.5" aria-label="Accueil SWU">
				<img src="/SWU.png" alt="" class="size-9 object-contain" width="36" height="36" />
				<span class="font-display hidden text-base font-bold tracking-wide uppercase sm:block">
					Sly Wrestling Universe
				</span>
				<span class="font-display text-base font-bold tracking-wide uppercase sm:hidden">SWU</span>
			</a>

			{# Desktop nav #}
			{% include '_includes/_nav' with {
				variant: 'desktop'
			} %}

			{# Mobile burger #}
			<button
				class="text-ink flex items-center p-2 lg:hidden"
				x-data
				x-on:click="$dispatch('toggle-menu')"
				aria-label="Ouvrir le menu"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="h-6 w-6"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
				>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
				</svg>
			</button>
		</div>
	</div>

	{# Mobile menu (panneau plein écran) #}
	{% include '_includes/_nav' with {
		variant: 'mobile'
	} %}
</header>
