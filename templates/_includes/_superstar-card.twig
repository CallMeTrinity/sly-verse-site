{# Superstar Card - WWE 2K game card style #}
{# Expects a `superstar` variable (entry from superstars section) #}
{% import '_includes/macros' as macros %}

{% set image = superstar.profileImage.one() %}

<a
	href="{{ superstar.url }}"
	class="group border-line bg-surface-2 hover:border-line-strong relative block h-full overflow-hidden rounded-lg border transition-all duration-300 hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-black/40"
>
	{# Image #}
	<div class="bg-surface-3 relative aspect-[3/4] overflow-hidden">
		{% if image %}
			{{
				macros.image(
					image,
					{
						width: 600,
						height: 800
					},
					'h-full w-full object-cover transition-transform duration-500 group-hover:scale-105'
				)
			}}
		{% else %}
			<div class="text-ink-faint flex h-full w-full items-center justify-center">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="h-16 w-16"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="1"
						d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
					/>
				</svg>
			</div>
		{% endif %}

		{# Overlay gradient #}
		<div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/25 to-transparent"></div>

		{# Overall Rating (Note) - top left corner #}
		{% if superstar.general is not null %}
			<div
				class="font-display absolute top-0 left-0 flex h-13 w-13 items-center justify-center bg-black/80 text-xl leading-none font-bold text-white"
			>
				{{ superstar.general|number_format(0) }}
			</div>
		{% endif %}

		{# Roster badge - top right #}
		{% if superstar.roster.value ?? null %}
			{{ macros.rosterBadge(superstar.roster, 'absolute top-3 right-3') }}
		{% endif %}

		{# Bottom overlay info - name + alignment #}
		<div class="absolute right-0 bottom-0 left-0 p-4">
			<div class="mb-2 flex items-center gap-2">
				{% if superstar.alignment.value ?? null %}
					{{ macros.alignmentDot(superstar.alignment) }}
					<span class="text-[11px] font-bold tracking-wide text-white/80 uppercase">
						{{ superstar.alignment.label }}
					</span>
				{% endif %}
			</div>

			<h3
				class="font-display group-hover:text-gold text-lg leading-tight font-bold text-white uppercase transition-colors"
			>
				{{ superstar.title }}
			</h3>

			{% if superstar.hometown %}
				<p class="text-ink-muted mt-1 text-xs">
					{{ superstar.hometown }}
				</p>
			{% endif %}

			{% if superstar.finisher %}
				<p class="text-gold mt-1.5 text-xs font-bold tracking-wide uppercase">
					Finisher : {{ superstar.finisher }}
				</p>
			{% endif %}
		</div>
	</div>
</a>
