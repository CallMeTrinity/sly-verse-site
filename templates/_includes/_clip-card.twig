{# @param clip - A clip entry with videoUrl, mainImage (optional), relatedSuperstars #}
{% import '_includes/macros' as macros %}
{% set image = clip.mainImage.one() ?? null %}

{# Auto YouTube thumbnail #}
{% set thumbUrl = null %}
{% if not image and clip.videoUrl %}
	{% if 'youtube.com/watch?v=' in clip.videoUrl %}
		{% set ytId = clip.videoUrl | split('v=') | last | split('&') | first %}
		{% set thumbUrl = 'https://img.youtube.com/vi/' ~ ytId ~ '/hqdefault.jpg' %}
	{% elseif 'youtu.be/' in clip.videoUrl %}
		{% set ytId = clip.videoUrl | split('youtu.be/') | last | split('?') | first %}
		{% set thumbUrl = 'https://img.youtube.com/vi/' ~ ytId ~ '/hqdefault.jpg' %}
	{% elseif 'youtube.com/shorts/' in clip.videoUrl %}
		{% set ytId = clip.videoUrl | split('shorts/') | last | split('?') | first %}
		{% set thumbUrl = 'https://img.youtube.com/vi/' ~ ytId ~ '/hqdefault.jpg' %}
	{% endif %}
{% endif %}

<a href="{{ clip.url }}" class="group block overflow-hidden rounded-lg bg-white/5 shadow-lg transition-all duration-300 hover:scale-[1.02] hover:bg-white/10 hover:shadow-2xl">
	<div class="relative aspect-video overflow-hidden bg-neutral-800">
		{% if image %}
			{{ macros.image(image, { width: 600, height: 340 }, 'h-full w-full object-cover transition-transform duration-500 group-hover:scale-110') }}
		{% elseif thumbUrl %}
			<img
				src="{{ thumbUrl }}"
				alt="{{ clip.title }}"
				class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
				loading="lazy"
			/>
		{% endif %}
		{# Play button overlay #}
		<div class="absolute inset-0 flex items-center justify-center">
			<div class="flex h-14 w-14 items-center justify-center rounded-full bg-white/20 backdrop-blur-sm transition-transform duration-300 group-hover:scale-110">
				<svg xmlns="http://www.w3.org/2000/svg" class="ml-1 h-6 w-6 text-white" viewBox="0 0 24 24" fill="currentColor">
					<path d="M8 5v14l11-7z" />
				</svg>
			</div>
		</div>
	</div>
	<div class="p-4">
		<h3 class="h6 mb-2 text-white">{{ clip.title }}</h3>
		{% set superstars = clip.relatedSuperstars.all() ?? [] %}
		{% if superstars | length %}
			<div class="flex flex-wrap gap-1.5">
				{% for superstar in superstars %}
					<span class="rounded-full bg-white/10 px-2 py-0.5 text-xs text-neutral-400">{{ superstar.title }}</span>
				{% endfor %}
			</div>
		{% endif %}
	</div>
</a>
