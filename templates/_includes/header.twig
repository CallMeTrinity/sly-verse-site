<header class="sticky top-0 z-50 bg-black/95 backdrop-blur-sm">
	<div class="grid-container">
		<div class="flex items-center justify-between py-3">
			{# Logo #}
			<a href="/" class="text-lg font-bold tracking-wider text-white uppercase">
				SWU
			</a>

			{# Desktop Nav #}
			{% set nav = craft.app.globals.getSetByHandle('navigation') %}
			{% if nav %}
				<nav class="hidden items-center gap-6 md:flex" aria-label="Menu principal">
					{% for item in nav.mainMenu.all() %}
						{% if item.typeDeLien.value == 'entry' and item.internalLink.url ?? null %}
							<a
								href="{{ item.internalLink.url }}"
								class="text-sm font-medium text-neutral-300 transition-colors hover:text-white"
							>
								{{ item.label }}
							</a>
						{% elseif item.typeDeLien.value == 'externalUrl' and item.externalLink ?? null %}
							<a
								href="{{ item.externalLink }}"
								class="text-sm font-medium text-neutral-300 transition-colors hover:text-white"
								target="_blank"
								rel="noopener noreferrer"
							>
								{{ item.label }}
							</a>
						{% endif %}
					{% endfor %}
				</nav>
			{% endif %}

			{# Mobile burger #}
			<button
				class="flex items-center text-white md:hidden"
				x-data
				x-on:click="$dispatch('toggle-menu')"
				aria-label="Ouvrir le menu"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
				</svg>
			</button>
		</div>
	</div>

	{# Mobile Menu #}
	{% if nav %}
		<div
			x-data="{ open: false }"
			x-on:toggle-menu.window="open = !open"
			x-show="open"
			x-cloak
			x-transition:enter="transition duration-200 ease-out"
			x-transition:enter-start="opacity-0 -translate-y-2"
			x-transition:enter-end="opacity-100 translate-y-0"
			x-transition:leave="transition duration-150 ease-in"
			x-transition:leave-start="opacity-100 translate-y-0"
			x-transition:leave-end="opacity-0 -translate-y-2"
			class="border-t border-white/10 md:hidden"
		>
			<nav class="grid-container py-4" aria-label="Menu mobile">
				{% for item in nav.mainMenu.all() %}
					{% if item.typeDeLien.value == 'entry' and item.internalLink.url ?? null %}
						<a
							href="{{ item.internalLink.url }}"
							class="block py-2 text-sm font-medium text-neutral-300 transition-colors hover:text-white"
						>
							{{ item.label }}
						</a>
					{% elseif item.typeDeLien.value == 'externalUrl' and item.externalLink ?? null %}
						<a
							href="{{ item.externalLink }}"
							class="block py-2 text-sm font-medium text-neutral-300 transition-colors hover:text-white"
							target="_blank"
							rel="noopener noreferrer"
						>
							{{ item.label }}
						</a>
					{% endif %}
				{% endfor %}
			</nav>
		</div>
	{% endif %}
</header>
